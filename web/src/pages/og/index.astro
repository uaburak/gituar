---
// Paylaşım görseli şablonu (1200×630): tarayıcıda ekran görüntüsü alınıp web/public/og.png olarak kaydedilir. Dizine girmez.
import { catalog } from "../../lib/catalog.ts";
const c = catalog();
const songCount = c.songs.length.toLocaleString("tr-TR");
const artistCount = c.artists.length.toLocaleString("tr-TR");
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>og</title>
  <style>
    html, body { margin: 0; }
    body { width: 1200px; height: 630px; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif; background: #f5f5f7; color: #1d1d1f; }
    .og { position: relative; width: 1200px; height: 630px; display: flex; align-items: center; }
    .text { padding: 0 0 0 84px; width: 600px; }
    .brand { display: flex; align-items: center; gap: 18px; margin-bottom: 44px; }
    .brand img { width: 72px; height: 72px; border-radius: 18px; }
    .brand span { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; }
    h1 { margin: 0 0 22px; font-size: 68px; line-height: 1.02; font-weight: 700; letter-spacing: -0.035em; }
    p { margin: 0; font-size: 28px; line-height: 1.35; color: #6e6e73; }
    .sheet { position: absolute; right: 72px; top: 96px; bottom: 96px; width: 400px; justify-content: center; background: #fff; border-radius: 28px; padding: 36px 40px; box-sizing: border-box; display: flex; flex-direction: column; gap: 14px; }
    .sheet .k { display: flex; gap: 10px; margin-bottom: 8px; }
    .sheet .k b { padding: 6px 14px; border-radius: 999px; background: #e8e8ed; font-size: 18px; font-weight: 600; }
    .sheet .k b.on { background: #0071e3; color: #fff; }
    .line { display: flex; flex-direction: column; gap: 6px; }
    .line .c { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 22px; font-weight: 700; color: #0066cc; white-space: pre; }
    .line .w { height: 12px; border-radius: 6px; background: #e8e8ed; }
    astro-dev-toolbar { display: none !important; }
    .chords { position: absolute; left: 84px; bottom: 56px; display: flex; gap: 12px; }
    .chords span { padding: 10px 18px; border-radius: 999px; background: #fff; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 22px; font-weight: 600; color: #0066cc; }
  </style>
</head>
<body>
  <div class="og">
    <div class="sheet" aria-hidden="true">
      <div class="k"><b>Ton</b><b>G</b><b class="on">Am</b><b>C</b></div>
      <div class="line"><span class="c">Am        F</span><span class="w" style="width:88%"></span></div>
      <div class="line"><span class="c">C         G</span><span class="w" style="width:72%"></span></div>
      <div class="line"><span class="c">Am     Em    F</span><span class="w" style="width:94%"></span></div>
      <div class="line"><span class="c">C    G     Am</span><span class="w" style="width:64%"></span></div>
      <div class="line"><span class="c">F         E7</span><span class="w" style="width:80%"></span></div>
    </div>
    <div class="text">
      <div class="brand"><img src="/img/app-icon.png" alt="" /><span>Gituar</span></div>
      <h1>Türkçe gitar akorları</h1>
      <p>Topluluğun paylaştığı akorlar. Transpoze, kapo ve otomatik kaydırma.</p>
    </div>
    <div class="chords"><span>Am</span><span>F</span><span>C</span><span>G</span><span>Em</span></div>
  </div>
  <script is:inline>setInterval(() => document.querySelectorAll("astro-dev-toolbar").forEach((e) => e.remove()), 50);</script>
</body>
</html>
