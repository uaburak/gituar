---
export const prerender = true;
import Base from "../../layouts/Base.astro";
---
<Base title="Repertuarlarım" noindex>
  <div class="page-head">
    <div class="title-row">
      <div><h1>Repertuarlarım</h1><p id="rep-meta">iPhone'daki Gituar ile eşitlenir</p></div>
      <button class="btn btn-primary" id="rep-new-btn" type="button" hidden>Yeni repertuar</button>
    </div>
  </div>
  <div id="rep-auth" class="alert" hidden>Repertuarlarını görmek için <a href="/giris/?next=/repertuarlarim/">giriş yap</a>.</div>
  <form id="rep-create" class="card rep-create" hidden>
    <input class="input" name="name" placeholder="Yeni repertuar adı · şarkıları şarkı sayfasından eklersin" required aria-label="Yeni repertuar adı" />
    <button class="btn btn-primary" type="submit">Oluştur</button>
  </form>
  <div class="grid-3 pick-grid rep-grid" id="rep-grid"></div>
  <p class="muted small" id="rep-status" style="margin-top:16px">Yükleniyor…</p>
  <script src="../../scripts/repertoires.ts"></script>
</Base>
