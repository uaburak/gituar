---
// Tek reklam bileşeni. Plus kullanıcılarında app.ts `html.plus` sınıfını koyar ve CSS hepsini gizler.
// AdSense yayıncı kimliği yoksa Wecra'daki gibi kesikli kutu kalır (tasarım ve ölçü kontrolü için).
import { ADSENSE_CLIENT, ADSENSE_SLOTS } from "../lib/site.ts";
interface Props { size: "side" | "leaderboard" | "rect" | "inline" | "sticky"; unit: string; class?: string }
const { size, unit, class: className = "" } = Astro.props;
const labels = { side: "160 × 600", leaderboard: "728 × 90", rect: "300 × 250", inline: "Liste içi · her 10 satırda bir", sticky: "320 × 50" };
const format = size === "side" ? "vertical" : size === "rect" ? "rectangle" : size === "sticky" ? "horizontal" : "auto";
// AdSense birimi (data-ad-slot) yer türüne göre .env'den gelir; `unit` yalnızca ölçüm/etiket içindir.
// 728×90 için ayrı birim yoksa duyarlı liste içi birimi kullanılır.
const slot = ADSENSE_SLOTS[size] || (size === "leaderboard" ? ADSENSE_SLOTS.inline : "");
// Yerelde (astro dev) AdSense reklam basmaz (onaylı alan adı ve birim ister). Bunun yerine Google'ın
// herkese açık örnek reklam ağından (Google Publisher Tag, /6355419/Travel/Europe) gerçek test reklamları çekilir.
// Canlıda hiçbir zaman çizilmez (import.meta.env.DEV yalnızca dev sunucusunda true).
const demo = import.meta.env.DEV;
const live = !demo && Boolean(ADSENSE_CLIENT && slot);
const testSizes: Record<typeof size, string> = { side: "160x600", leaderboard: "728x90", rect: "300x250", inline: "728x90", sticky: "320x50" };
// AdSense'te sabit boyutlu oluşturulan birimler (yan 160×600, mobil alt 320×50); diğerleri duyarlı
const fixed = size === "side" ? { w: 160, h: 600 } : size === "sticky" ? { w: 320, h: 50 } : null;
---
{demo && (
  <div class:list={["ad-slot", `ad-${size}`, "ad-test", className]} data-unit={unit} aria-label="Google test reklamı (yalnızca yerelde)">
    <div class="gpt-test" data-gpt-size={testSizes[size]}></div>
    <span class="ad-test-label">Test reklamı · {labels[size]}</span>
  </div>
)}
{demo && (
  <script is:inline>
    // Google Publisher Tag'i bir kez yükle; sayfadaki test yerlerini Google'ın herkese açık örnek ağından doldur.
    // Örnek ağ aynı sayfaya bir boyuttan çoğu zaman tek reklam verir; boş dönen yer ölçülü test kutusu olarak kalır.
    if (!window.__gptTest) {
      window.__gptTest = true;
      window.googletag = window.googletag || { cmd: [] };
      const s = document.createElement("script");
      s.src = "https://securepubads.g.doubleclick.net/tag/js/gpt.js";
      s.async = true;
      document.head.appendChild(s);
      const units = ["/6355419/Travel/Europe", "/6355419/Travel/Asia", "/6355419/Travel/Europe/France", "/6355419/Travel/Europe/Germany"];
      const fill = () => googletag.cmd.push(() => {
        let n = 0;
        document.querySelectorAll(".gpt-test:not([id])").forEach((el) => {
          const box = el.closest(".ad-slot");
          if (getComputedStyle(box).display === "none" || (el.closest(".side-ad") && !el.closest(".side-ad").offsetWidth)) return;
          const [w, h] = el.dataset.gptSize.split("x").map(Number);
          el.id = "gpt-test-" + n;
          googletag.defineSlot(units[n++ % units.length], [w, h], el.id)?.addService(googletag.pubads());
        });
        googletag.pubads().addEventListener("slotRenderEnded", (e) => {
          if (e.isEmpty) document.getElementById(e.slot.getSlotElementId())?.closest(".ad-slot")?.classList.add("ad-test-empty");
        });
        googletag.pubads().enableSingleRequest();
        googletag.enableServices();
        document.querySelectorAll(".gpt-test[id]").forEach((el) => googletag.display(el.id));
      });
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", fill); else fill();
    }
  </script>
)}
{!demo && (live || !ADSENSE_CLIENT) && (
  <div class:list={["ad-slot", `ad-${size}`, className]} data-unit={unit} aria-label="Reklam">
    {live
      ? (fixed
          ? <ins class="adsbygoogle" style={`display:inline-block;width:${fixed.w}px;height:${fixed.h}px`} data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}></ins>
          : <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format={format} data-full-width-responsive="true"></ins>)
      : <div class="ad-placeholder"><b>REKLAM</b><span>{labels[size]}</span></div>}
  </div>
)}
