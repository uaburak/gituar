---
// Bulunamayan adresler ve silinen şarkılar buraya yönlenir (Astro.rewrite); durum kodu 404.
import ListSection from "../components/ListSection.astro";
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---
<Base title="Sayfa bulunamadı" noindex ads={false}>
  <div class="rp-head"><h1>Bu akor burada değil</h1></div>
  <div class="rp-content"><p>Sayfa taşınmış ya da silinmiş olabilir.</p></div>
  <ListSection title="Şarkı ara" color="#ea494d" href="/ara/" />
  <ListSection title="Sanatçılar" color="#ffcc00" href="/sanatcilar/" />
  <ListSection title="Ana sayfa" icon="heart" color="#ea494d" href="/" />
</Base>
