---
import Base from "../../layouts/Base.astro";
import { catalog } from "../../lib/catalog.ts";
import { keySlug, keyTurkish } from "../../lib/keys.ts";
import { allKeyInfos } from "../../lib/catalog-rules.mjs";
import { siteUrl, breadcrumbJsonLd } from "../../lib/seo.ts";

void catalog;
const keys = allKeyInfos().filter((k) => k.total >= 10).sort((a, b) => b.total - a.total).map((k) => [k.spellings.join(" / "), k.total, k.name] as const);
const base = siteUrl(Astro.site);
const description = "Gitar akorlarını tona göre bul: majör ve minör tonlarda şarkı listeleri, her tonun sık kullanılan akorları. Transpoze ve kapo ile istediğin tona taşı.";
---
<Base title="Tona Göre Şarkı Akorları – Majör ve Minör Tonlar" description={description} jsonLd={[{ "@context": "https://schema.org", "@type": "CollectionPage", name: "Tona göre şarkı akorları", url: `${base}/ton/`, description, inLanguage: "tr" }, breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Tonlar", path: "/ton/" }])]}>
  <div class="page-head">
    <div class="crumbs"><a href="/">Ana sayfa</a><span>/</span>Tonlar</div>
    <h1>Tona göre şarkı akorları</h1>
    <p>Hangi tonda çalmak istiyorsan o tondaki şarkıları listele. Sayfa başında tonun sık kullanılan akorları yazar.</p>
  </div>
  <div class="grid-3 pick-grid">
    {keys.map(([label, n, k]) => (
      <a class="card pick" href={`/ton/${keySlug(k)}/`}><span class="pick-tile mono" aria-hidden="true">{k}</span><span class="pick-body"><span class="pick-title">{label} tonu</span><span class="muted small">{keyTurkish(k)}</span></span><span class="pick-arrow" aria-hidden="true">›</span></a>
    ))}
  </div>
</Base>
