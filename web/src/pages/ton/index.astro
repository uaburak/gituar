---
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
import { catalog } from "../../lib/catalog.ts";
import { keySlug, keyTurkish } from "../../lib/keys.ts";
import { allKeyInfos, minKeySongs } from "../../lib/catalog-rules.mjs";
import { siteUrl, breadcrumbJsonLd } from "../../lib/seo.ts";

void catalog;
const keys = allKeyInfos().filter((k) => k.total >= minKeySongs()).sort((a, b) => b.total - a.total).map((k) => [k.spellings.join(" / "), k.total, k.name] as const);
const base = siteUrl(Astro.site);
const description = "Gitar akorlarını tona göre bul: majör ve minör tonlarda şarkı listeleri, her tonun sık kullanılan akorları. Transpoze ve kapo ile istediğin tona taşı.";
---
<Base title="Tona Göre Şarkı Akorları – Majör ve Minör Tonlar" description={description} jsonLd={[{ "@context": "https://schema.org", "@type": "CollectionPage", name: "Tona göre şarkı akorları", url: `${base}/ton/`, description, inLanguage: "tr" }, breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Tonlar", path: "/ton/" }])]}>
  <div class="rp-head"><h1>Tona göre şarkı akorları</h1></div>
  <div class="rp-content">
    <p>Hangi tonda çalmak istiyorsan o tondaki şarkıları listele. Ton sayfasının başında o tonun sık kullanılan akorları yazar.</p>
  </div>
  <ListSection title="Tonlar" color="#ea494d" open>
    <ul class="rp-list rp-split">
      {keys.map(([label, n, k]) => (
        <li><a class="row" href={`/ton/${keySlug(k)}/`} title={`${label} tonunda şarkı akorları`}><span class="rp-badge rp-badge-key" aria-hidden="true">{k}</span><span class="rp-text"><span class="row-title">{label} tonu</span><span class="row-note"> · {keyTurkish(k)}</span></span></a></li>
      ))}
    </ul>
  </ListSection>
  <ListSection title="Gitar akorları tablosu" color="#f0a800" href="/akorlar/" />
</Base>
