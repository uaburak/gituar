---
export const prerender = true;
import Base from "../../layouts/Base.astro";
---
<Base title="Yönetim" noindex ads={false}>
  <div class="page-head">
    <div class="title-row">
      <div><h1>Yönetim</h1><p id="admin-meta">Onay bekleyen şarkılar, şikayetler, Pro üyeler ve toplu içe aktarma · iPhone uygulamasındaki yönetim ile aynı veriler</p></div>
      <button class="btn" id="admin-refresh" type="button" hidden>Yenile</button>
    </div>
  </div>
  <div id="admin-auth" class="alert" hidden>Yönetim için <a href="/giris/?next=/admin/">giriş yap</a>.</div>
  <div id="admin-denied" class="alert alert-error" hidden>Bu sayfa yalnızca yönetici hesapları için.</div>

  <section class="section" id="admin-pending" hidden>
    <div class="section-head"><h2>Onay bekleyen şarkılar</h2><span class="muted small" id="pending-count"></span></div>
    <div class="list" id="pending-list"></div>
  </section>

  <section class="section" id="admin-reports" hidden>
    <div class="section-head">
      <h2>Şikayetler</h2>
      <div class="chip-row" id="report-filter">
        <button class="btn chip active" type="button" data-f="open">Açık</button>
        <button class="btn chip" type="button" data-f="closed">Kapatılan</button>
      </div>
    </div>
    <div class="list" id="reports-list"></div>
  </section>

  <section class="section" id="admin-pro" hidden>
    <div class="section-head"><h2>Pro üyeler</h2><span class="muted small" id="pro-count"></span></div>
    <form class="admin-pro-form" id="pro-form">
      <input class="input" id="pro-username" placeholder="Kullanıcı adı (@ olmadan)" autocomplete="off" required aria-label="Kullanıcı adı" />
      <input class="input" id="pro-note" placeholder="Not (isteğe bağlı): ör. beta testçisi" autocomplete="off" aria-label="Not" />
      <select class="input" id="pro-duration" aria-label="Süre">
        <option value="1">1 ay</option>
        <option value="3">3 ay</option>
        <option value="12">1 yıl</option>
        <option value="0">Süresiz</option>
      </select>
      <button class="btn btn-primary" type="submit">Pro ver</button>
    </form>
    <p class="muted small" id="pro-msg"></p>
    <div class="list" id="pro-list"></div>
  </section>

  <section class="section" id="admin-import" hidden>
    <div class="section-head"><h2>JSON'dan şarkı içe aktar</h2></div>
    <p class="muted small">iPhone'daki içe aktarmayla aynı biçim: <code>[&#123;"songName", "artist", "originalKey", "content"&#125;]</code>. Şarkılar doğrudan yayına girer.</p>
    <div class="admin-import">
      <input type="file" accept="application/json,.json" id="imp-file" class="input" aria-label="JSON dosyası" />
      <button class="btn btn-primary" type="button" id="imp-start" disabled>Yükle</button>
    </div>
    <p class="muted small" id="imp-msg"></p>
    <div class="list" id="imp-preview"></div>
  </section>

  <section class="section" id="admin-bulk" hidden>
    <div class="section-head"><h2>Toplu repertuar yükle</h2></div>
    <p class="muted small">Biçim: <code>[&#123;"name": "Başlangıç için", "songIds": ["…"]&#125;]</code>. Şarkı; kimliğiyle, <code>sanatçı-slug/şarkı-slug</code> adresiyle ya da <code>Sanatçı - Şarkı</code> adıyla yazılabilir. Repertuarlar herkese açık olarak (Editörün Seçimleri) senin adına eklenir.</p>
    <div class="admin-import">
      <input type="file" accept="application/json,.json" id="bulk-file" class="input" aria-label="JSON dosyası" />
      <button class="btn btn-primary" type="button" id="bulk-start" disabled>Yükle</button>
    </div>
    <p class="muted small" id="bulk-msg"></p>
    <div class="list" id="bulk-preview"></div>
  </section>

  <p class="muted small" id="admin-status" style="margin-top:16px">Yükleniyor…</p>
  <script src="../../scripts/admin.ts"></script>
</Base>
