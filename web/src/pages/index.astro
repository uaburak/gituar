---
import Base from "../layouts/Base.astro";
import SongList from "../components/SongList.astro";
import ArtistRow from "../components/ArtistRow.astro";
import AdSlot from "../components/AdSlot.astro";
import Icon from "../components/Icon.astro";
import { catalog, newestSongs, topArtists } from "../lib/catalog.ts";
import { siteUrl, homeJsonLd } from "../lib/seo.ts";
import { APP_STORE_URL } from "../lib/site.ts";

const c = catalog();
const newest = newestSongs(8);
const artists = topArtists(8);
const songCount = c.songs.length.toLocaleString("tr-TR");
const artistCount = c.artists.length.toLocaleString("tr-TR");
const title = `Gitar Akorları – ${songCount} Türkçe Şarkı Akoru`;
const description = `Gitar akorları: ${songCount} Türkçe şarkı akoru, ${artistCount} sanatçı. Akor transpoze, kapo ve otomatik kaydırma ile çal, repertuar oluştur. iOS uygulamasıyla aynı katalog.`;
---
<Base title={title} description={description} jsonLd={homeJsonLd(siteUrl(Astro.site))}>
  <section class="hero">
    <p class="eyebrow">{songCount} akor · {artistCount} sanatçı</p>
    <h1>Türkçe gitar akorları</h1>
    <p>Şarkıyı bul, tonu değiştir, kapo tak, sayfayı oynat. Akorlar sözlerin üstünde, orijinal tonuyla.</p>
    <form class="search-big" action="/ara/" method="get" role="search">
      <Icon name="search" />
      <input type="search" name="q" placeholder="Şarkı ya da sanatçı ara" autocomplete="off" aria-label="Ara" autofocus />
      <button class="btn btn-primary" type="submit">Ara</button>
    </form>
    <div class="chip-row">
      <a class="btn chip" href="/sanatcilar/">Sanatçı akorları</a>
      <a class="btn chip" href="#yeni">Yeni eklenen akorlar</a>
      <button class="btn chip" id="btn-random" type="button">Rastgele akor</button>
    </div>
  </section>

  <section class="section" id="editor" hidden>
    <div class="section-head"><div><h2>Editörün seçimleri</h2><p class="section-sub">Gituar ekibinin hazırladığı repertuarlar</p></div></div>
    <div class="grid-3 pick-grid" id="editor-picks"></div>
  </section>

  <section class="section" id="yeni">
    <div class="two-col">
      <div>
        <div class="section-head"><h2>Yeni eklenen akorlar</h2><a href="/sanatcilar/">Sanatçıya göre bul<span aria-hidden="true"> ›</span></a></div>
        <SongList songs={newest} />
      </div>
      <div>
        <div class="section-head"><h2>Popüler sanatçılar</h2><a href="/sanatcilar/">Tüm sanatçı akorları<span aria-hidden="true"> ›</span></a></div>
        <div class="list">{artists.map((a) => <ArtistRow artist={a} />)}</div>
      </div>
    </div>
    <AdSlot size="inline" unit="home-inline" />
  </section>

  <section class="section">
    <div class="section-head center"><h2>Çalmayı kolaylaştıran araçlar</h2></div>
    <div class="grid-3 feature-grid">
      <div class="feature">
        <div class="feature-icon" aria-hidden="true"><span class="feature-glyph">A→C</span></div>
        <h3>Akor transpoze</h3>
        <p>Ton şeridinden yeni tonu seç; akorlar anında kayar, söz hizası bozulmaz.</p>
      </div>
      <div class="feature">
        <div class="feature-icon" aria-hidden="true"><span class="feature-glyph">Kapo</span></div>
        <h3>Kapo hesabı</h3>
        <p>Perdeyi gir, sayfa gerçekte çaldığın akor adlarını gösterir. Ukulele için de aynı adlar.</p>
      </div>
      <div class="feature">
        <div class="feature-icon" aria-hidden="true"><Icon name="play" class="icon" /></div>
        <h3>Sayfayı oynat</h3>
        <p>Otomatik kaydırma akor alanında akar, hızı sana uyar; elini gitardan çekmezsin.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="promo-card">
      <div class="promo-text">
        <p class="eyebrow">iPhone uygulaması</p>
        <h2>Gituar cebinde</h2>
        <p>Aynı katalog, aynı repertuarlar. Çevrimdışı çalışır; Plus ile web ve iPhone'da reklamsız.</p>
      </div>
      <a class="btn btn-primary btn-lg" href={APP_STORE_URL} rel="noopener"><Icon name="download" class="icon-sm" />App Store'dan indir</a>
    </div>
  </section>

  <section class="section about">
    <div class="section-head"><h2>Şarkı akorları, transpoze ve kapo</h2></div>
    <div class="about-cols">
      <p>Gituar'da {artistCount} sanatçının {songCount} şarkısının gitar akorları söz üstünde, orijinal tonuyla durur. <a href="/sanatcilar/">Sanatçı akorları dizininden</a> ya da aramadan şarkıyı bul, akorları sözlerle birlikte çal.</p>
      <p>Akor transpoze için ton şeridinden yeni tonu seç; akorlar anında kayar, söz hizası bozulmaz. Kapo takıyorsan perdeyi gir, sayfa çaldığın akor adlarını gösterir. Otomatik kaydırma ile elini gitardan çekmeden çalarsın. Akor adları ukulele için de aynıdır.</p>
      <p>Repertuar oluşturup şarkılarını topla; <a href={APP_STORE_URL} rel="noopener">iPhone uygulaması</a> aynı kataloğu ve repertuarları kullanır. Akorlar topluluk tarafından eklenir, hatalı akoru <a href="/iletisim/">bildirebilirsin</a>.</p>
    </div>
  </section>
  <script src="../scripts/random.ts"></script>
  <script src="../scripts/editor-picks.ts"></script>
</Base>
