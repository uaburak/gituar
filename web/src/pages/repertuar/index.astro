---
export const prerender = true;
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="Repertuar" noindex>
  <div class="rp-head"><h1 id="rep-title">Repertuar</h1></div>
  <div class="rp-content"><p id="rep-meta" class="muted"></p></div>
  <ListSection title="Şarkılar" icon="bolt" color="#ea494d" open>
    <ul class="rp-list" id="rep-songs"></ul>
    <p class="muted small rp-empty" id="rep-status">Yükleniyor…</p>
  </ListSection>
  <ListSection title="Repertuarlarım" icon="none" href="/repertuarlarim/" />
  <script src="../../scripts/repertoire.ts"></script>
</Base>
