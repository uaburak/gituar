---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdSlot from "../components/AdSlot.astro";
import { SITE_NAME, APP_STORE_ID, ADSENSE_CLIENT } from "../lib/site.ts";
import { jsonLdText } from "../lib/seo.ts";

interface Props {
  /** Sayfa başlığı; " · Gituar" eki burada eklenir (şablonlar: docs/SEO.md). */
  title: string;
  description?: string;
  /** Şarkı sayfalarında Safari Smart App Banner'ın uygulamayı doğrudan o şarkıda açması için */
  songId?: string;
  noindex?: boolean;
  q?: string;
  /** İki yandaki 160×600 ve telefondaki yapışkan reklam. Giriş gibi yardımcı sayfalarda kapalı. */
  ads?: boolean;
  /** Open Graph nesne türü: şarkı sayfası music.song, sanatçı sayfası profile. */
  ogType?: "website" | "music.song" | "profile";
  /** Sayfanın yapısal verisi (schema.org); tek script olarak basılır. */
  jsonLd?: unknown;
  /** Kopya sayfalarda asıl sayfanın yolu. */
  canonicalPath?: string;
  /** true ise " · Gituar" eklenmez (uzun şarkı başlıkları). */
  bareTitle?: boolean;
  /** İçerik tek bir beyaz panelin içinde (Repertuarım düzeni). Pro, Hesabım, Giriş kendi tasarımında: false. */
  card?: boolean;
}
const {
  title,
  description = "Türkçe gitar akorları, transpoze, kapo ve repertuarlar. iOS uygulamasıyla aynı katalog.",
  songId,
  noindex = false,
  q = "",
  ads = true,
  ogType = "website",
  jsonLd,
  canonicalPath,
  bareTitle = false,
  card = true,
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? "https://gituar.com").href;
const appArgument = songId ? `gituar://song/${songId}` : "gituar://";
const fullTitle = bareTitle ? title : `${title} · ${SITE_NAME}`;
// Search Console doğrulaması: web/.env içine PUBLIC_GSC_VERIFICATION=... yazılınca meta basılır.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? "";
// Paylaşım görseli: web/public/og.png (1200×630); /og/ şablonundan üretilir.
const ogImage = new URL("/og.png", Astro.site ?? "https://gituar.com").href;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <!-- Safari'de yerel "App Store'dan indir" bandı; uygulama yüklüyse "Aç" olur ve şarkıya gider -->
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}, app-argument=${appArgument}`} />
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {ads && ADSENSE_CLIENT && <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />}
    <meta name="theme-color" content="#f5f5f7" id="theme-color" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("gituar-theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
          // Masaüstünde yerel kaydırma çubuğu ilk çizimden gizli (sayfa kaymasın); yüzen çubuğu scrollbar.ts çizer
          if (window.matchMedia("(pointer: fine)").matches) document.documentElement.classList.add("overlay-scroll");
          if (localStorage.getItem("gituar-auth") === "1") {
            document.documentElement.classList.add("signed-in");
            if (localStorage.getItem("gituar-admin") === "1") document.documentElement.classList.add("is-admin");
          }
          if (localStorage.getItem("gituar-pro") === "1") document.documentElement.classList.add("pro");
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <!-- Çerez izni (KVKK açık rıza): Kabul et → kişiselleştirilmiş reklam, Reddet → kişiselleştirilmemiş reklam.
         Karar verilene kadar reklamlar kişiselleştirilmemiş istenir (app.ts). Seçim localStorage "gituar-consent" = "all" | "necessary";
         eski "1" (yalnızca bilgilendirme) geçerli rıza sayılmaz, bildirim yeniden gösterilir. Alt bilgideki "Çerez tercihleri" yeniden açar.
         Gövdenin başında: uzun sayfalarda ilk çizimle birlikte görünsün (sayfa sonunda olunca LCP/Speed Index bozuluyordu). -->
    <div class="consent" id="consent" hidden role="region" aria-label="Çerez izni">
      <p>Reklamları göstermek için Google çerezlerini kullanıyoruz. Kabul edersen reklamlar ilgi alanlarına göre seçilir, reddedersen kişiselleştirilmemiş reklam görürsün. Ayrıntılar <a href="/gizlilik/">Gizlilik ve Çerez Politikası</a>'nda.</p>
      <div class="consent-actions">
        <button type="button" class="btn" id="consent-reject">Reddet</button>
        <button type="button" class="btn" id="consent-accept">Kabul et</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById("consent");
        var c = null;
        try { c = localStorage.getItem("gituar-consent"); } catch (e) {}
        if (c !== "all" && c !== "necessary") box.hidden = false;
        function choose(v) {
          try { localStorage.setItem("gituar-consent", v); } catch (e) {}
          box.hidden = true;
          document.dispatchEvent(new CustomEvent("gituar:consent", { detail: v }));
        }
        document.getElementById("consent-accept").addEventListener("click", function () { choose("all"); });
        document.getElementById("consent-reject").addEventListener("click", function () { choose("necessary"); });
      })();
    </script>
    <div class:list={["shell", { "shell-plain": !ads }]}>
      {ads && <aside class="side-ad" aria-label="Reklam sütunu"><AdSlot size="side" unit="side-left" /></aside>}
      <main class="page">
        {ads && <AdSlot size="leaderboard" unit="top" class="ad-top" />}
        {card ? <div class="page-card"><slot /></div> : <slot />}
      </main>
      {ads && <aside class="side-ad" aria-label="Reklam sütunu"><AdSlot size="side" unit="side-right" /></aside>}
    </div>
    <Footer />
    <script src="../scripts/app.ts"></script>
    <script src="../scripts/shortcuts.ts"></script>
    <script src="../scripts/scrollbar.ts"></script>
  </body>
</html>
