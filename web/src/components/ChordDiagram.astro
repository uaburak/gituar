---
// Gitar akor diyagramı (SVG; tıklayınca akor çalar, app.ts → chord-audio.ts): 6 tel, 5 perde; açık/çalınmayan tel işaretleri, barre çubuğu, başlangıç perdesi.
import type { Shape } from "../lib/chord-theory.ts";
interface Props { shape: Shape; label: string; size?: "sm" | "lg"; href?: string; caption?: string }
const { shape, label, size = "sm", href, caption } = Astro.props;
const played = shape.frets.filter((f) => f > 0);
const minFret = played.length ? Math.min(...played) : 1;
const maxFret = played.length ? Math.max(...played) : 1;
const start = maxFret <= 5 ? 1 : minFret;
const W = 100, H = 120, left = 14, top = 22, sx = 14.4, sy = 18;
const x = (s: number) => left + s * sx;
const y = (f: number) => top + (f - start + 0.5) * sy;
const barre = shape.barre && shape.barre >= start ? shape.barre : undefined;
const barreStrings = barre ? shape.frets.map((f, i) => (f === barre ? i : -1)).filter((i) => i >= 0) : [];
const title = `${label} akoru${shape.name ? `, ${shape.name.toLocaleLowerCase("tr-TR")}` : ""}`;
---
<div class={`chord-diagram ${size}`}>
  <button type="button" class="cd-play" data-frets={shape.frets.join(",")} title={`${title} · dinle`} aria-label={`${label} akorunu dinle`}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
    {start === 1 ? <rect x={x(0)} y={top - 3} width={x(5) - x(0)} height="3" class="cd-nut" /> : <text x={left - 4} y={y(start) + 4} class="cd-fret" text-anchor="end">{start}</text>}
    {[0, 1, 2, 3, 4, 5].map((i) => <line x1={x(0)} x2={x(5)} y1={top + i * sy} y2={top + i * sy} class="cd-line" />)}
    {[0, 1, 2, 3, 4, 5].map((s) => <line x1={x(s)} x2={x(s)} y1={top} y2={top + 5 * sy} class="cd-line" />)}
    {barre && barreStrings.length > 1 && (
      <rect x={x(barreStrings[0]) - 5} y={y(barre) - 5} width={x(barreStrings[barreStrings.length - 1]) - x(barreStrings[0]) + 10} height="10" rx="5" class="cd-dot" />
    )}
    {shape.frets.map((f, s) =>
      f === -1 ? <text x={x(s)} y={top - 7} class="cd-mark" text-anchor="middle">×</text>
      : f === 0 ? <circle cx={x(s)} cy={top - 10} r="3.2" class="cd-open" />
      : barre && f === barre && barreStrings.length > 1 ? null
      : <circle cx={x(s)} cy={y(f)} r="5" class="cd-dot" />
    )}
  </svg>
  </button>
  {href ? <a class="cd-label" href={href} title={title}>{label}</a> : <span class="cd-label">{label}</span>}
  {caption && <span class="cd-caption">{caption}</span>}
</div>
