---
// Logo sayfaya gömülü (data URI, ~5 KB): ayrı istek yok, sayfa geçişlerinde yeniden yüklenip yanıp sönmez.
import logo from "../assets/logo-64.png?inline";
interface Props { class?: string; wordmark?: boolean }
const { class: className = "brand", wordmark = false } = Astro.props;
---
<a href="/" class={className} aria-label="Gituar ana sayfa">
  <img class="brand-mark" src={logo} width="32" height="32" alt="Gituar" decoding="sync" />
  {wordmark && <span class="brand-name" aria-hidden="true">Gituar</span>}
</a>
