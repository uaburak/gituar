---
// Tek dosyada hat ikonları (Wecra "İkon/*" bileşenlerinin karşılığı). 24'lük kutu, currentColor.
interface Props { name: "search" | "download" | "menu" | "close" | "print" | "bookmark" | "play" | "pause" | "plus" | "minus" | "chevron" | "random" | "moon" | "sun" | "star" | "people" | "mic" | "google" | "crown" | "apple" | "flag" | "down"; class?: string }
const { name, class: className = "icon" } = Astro.props;
const stroke = { fill: "none", stroke: "currentColor", "stroke-width": "1.8", "stroke-linecap": "round", "stroke-linejoin": "round" } as const;
---
{name === "search" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>}
{name === "download" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"/></svg>}
{name === "menu" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>}
{name === "close" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>}
{name === "print" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M7 9V4h10v5M7 17H5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2"/><path d="M7 14h10v6H7z"/></svg>}
{name === "bookmark" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M6 4h12v17l-6-4-6 4z"/></svg>}
{name === "play" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>}
{name === "pause" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>}
{name === "plus" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>}
{name === "minus" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M5 12h14"/></svg>}
{name === "chevron" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>}
{name === "random" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>}
{name === "moon" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>}
{name === "sun" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>}
{name === "star" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6.1 6.7.8-4.9 4.6 1.3 6.6L12 17.4l-6 3.3 1.3-6.6L2.4 9.5l6.7-.8z"/></svg>}
{name === "people" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7 .5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 18.2c0-3 2.9-5.2 6.5-5.2s6.5 2.2 6.5 5.2c0 .6-.4 1-1 1h-11c-.6 0-1-.4-1-1Zm14.2 1c.2-.3.3-.7.3-1 0-1.9-.9-3.5-2.3-4.7.4-.1.9-.2 1.3-.2 3 0 5.5 1.9 5.5 4.3 0 .5-.4 1-1 1h-3.3a2 2 0 0 1-.5.6Z"/></svg>}
{name === "mic" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 15a4 4 0 0 0 4-4V6a4 4 0 0 0-8 0v5a4 4 0 0 0 4 4Zm-6.5-4a1 1 0 1 1 2 0 4.5 4.5 0 0 0 9 0 1 1 0 1 1 2 0 6.5 6.5 0 0 1-5.5 6.4V20h2.5a1 1 0 1 1 0 2h-7a1 1 0 1 1 0-2H11v-2.6A6.5 6.5 0 0 1 5.5 11Z"/></svg>}
{name === "google" && <svg class={className} viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 14a6 6 0 0 1 0-3.8V7.6H3.1a10 10 0 0 0 0 9l3.3-2.6Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.6l3.3 2.6C7.2 7.8 9.4 6 12 6Z"/></svg>}
{name === "crown" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 7.5 7.5 11 12 4l4.5 7L21 7.5 19 18H5L3 7.5ZM5 20h14v1.5H5z"/></svg>}
{name === "apple" && <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7a4.5 4.5 0 0 0-3.5-1.9c-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8A4.8 4.8 0 0 0 4 9.5c-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.4-1-2.4-3.9ZM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4Z"/></svg>}
{name === "flag" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="M5 21V4m0 0h11l-2 4 2 4H5"/></svg>}
{name === "down" && <svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>}
