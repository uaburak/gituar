---
import Base from "../layouts/Base.astro";
import SongList from "../components/SongList.astro";
import ArtistRow from "../components/ArtistRow.astro";
import ListSection from "../components/ListSection.astro";
import { catalog, newestSongs, topArtists } from "../lib/catalog.ts";
import { siteUrl, homeJsonLd } from "../lib/seo.ts";
import { buildEditorPicks } from "../lib/editor-picks-build.ts";

// Popüler: gerçek popülerlik puanı (kişi başına görüntülenme/favori/repertuar); puan yoksa en yeniler.
// "Tümü" olan listeler 19 öğe gösterir; 20. hücre "Tümü" satırıdır.
const SHOW = 19;
const all = catalog().songs;
const scored = [...all].filter((s) => (s.score ?? 0) > 0).sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
const popular = (scored.length >= 20 ? scored : [...scored, ...[...all].sort((a, b) => b.seq - a.seq).filter((s) => !scored.includes(s))]).slice(0, SHOW);
const newest = newestSongs(SHOW);
const artists = topArtists(SHOW);
const newestArtists = [...catalog().artists].sort((a, b) => Math.max(...b.songs.map((s) => s.seq)) - Math.max(...a.songs.map((s) => s.seq))).slice(0, SHOW);
// Öne Çıkanlar: editörün seçimleri (admin hesapların herkese açık repertuarları); sunucuda alınamazsa tarayıcı yükler
const byId = catalog().byId;
const picks = (await buildEditorPicks()).map((p) => ({ ...p, count: p.songIds.filter((id) => byId.has(id)).length })).filter((p) => p.count > 0);
const title = "Gitar Akorları – Türkçe Şarkı Akorları, Transpoze ve Kapo";
const description = "Türkçe şarkıların gitar akorları: topluluğun paylaştığı akorları transpoze, kapo ve otomatik kaydırma ile çal, repertuar oluştur. iPhone uygulamasıyla aynı akorlar.";
---
<Base title={title} description={description} jsonLd={homeJsonLd(siteUrl(Astro.site))}>
  <h1 class="visually-hidden">Türkçe gitar akorları</h1>
  <ListSection title="Popüler Akorlar" icon="bolt" color="#ea494d" all="/populer-akorlar/">
    <SongList songs={popular} cols={1} />
  </ListSection>
  <ListSection title="Rastgele" color="#c077db" id="random">
    <ul class="rp-list" id="random-list" data-total={catalog().songs.length}></ul>
    <p class="muted small rp-empty" id="random-status">Yükleniyor…</p>
    <button type="button" class="rp-more rp-more-btn" id="random-refresh">Başka şarkılar getir</button>
  </ListSection>
  <ListSection title="Öne Çıkanlar" color="#f0a800" id="featured" all="/editorun-secimleri/">
    <ul class="rp-list" id="editor-picks">
      {picks.map((p) => (
        <li><a class="row" href={`/repertuar/?id=${p.id}`} title={p.name}><span class="rp-badge rp-badge-list" aria-hidden="true">R</span><span class="rp-text"><span class="row-title">{p.name}</span><span class="row-note"> · {p.count} şarkı</span></span></a></li>
      ))}
    </ul>
    {picks.length === 0 && <p class="muted small rp-empty" id="editor-status">Yükleniyor…</p>}
  </ListSection>
  <ListSection title="Yeni Akorlar" color="#ff9500" all="/yeni-eklenenler/">
    <SongList songs={newest} cols={1} />
  </ListSection>
  <ListSection title="Gece Modu" icon="moon" color="#5e5ce6" action="theme-toggle-home" />
  <ListSection title="Son Çaldıklarım" color="#54779a" id="recent">
    <ul class="rp-list" id="recent-list"></ul>
    <p class="muted small" id="recent-empty">Açtığın şarkılar burada listelenir. Bu liste yalnızca bu tarayıcıda tutulur.</p>
  </ListSection>
  <ListSection title="Repertuarlarım" icon="star" color="#f0a800" id="my-reps" all="/repertuarlarim/">
    <ul class="rp-list" id="my-reps-list"></ul>
    <p class="muted small rp-empty" id="my-reps-status">Yükleniyor…</p>
  </ListSection>
  <ListSection title="Popüler Sanatçılar" color="#499c9f" all="/sanatcilar/">
    <ul class="rp-list">{artists.map((a) => <ArtistRow artist={a} />)}</ul>
  </ListSection>
  <ListSection title="Yeni Eklenen Sanatçılar" color="#54779a" all="/sanatcilar/">
    <ul class="rp-list">{newestArtists.map((a) => <ArtistRow artist={a} />)}</ul>
  </ListSection>
  <ListSection title="İstek, Öneri, Şikayet" icon="quote" color="#c077db" href="/iletisim/" />
  <ListSection title="gituar.com" icon="heart" color="#ea494d" href="/hakkinda/" />
  <section class="rp-seo" aria-labelledby="seo-title">
    <h2 id="seo-title">Gitar akorları, transpoze ve kapo tek sayfada</h2>
    <p>Gituar, Türkçe şarkıların gitar akorlarını bir araya getiren ücretsiz bir akor sitesidir. Şarkıların akorlarını sözlerin üstünde, orijinal tonuyla görürsün; tek dokunuşla tonu değiştirir, kapo takacağın perdeye göre akorları yeniden yazdırırsın.</p>
    <h3>Akorları kendi sesine göre çal</h3>
    <p>Şarkı sesine yüksek ya da alçak geliyorsa ton şeridinden istediğin tonu seç; bütün akorlar birlikte transpoze edilir. Barre akorlardan kaçınmak istiyorsan kapo ekle, sayfa tutman gereken açık akorları gösterir. Yazı boyutunu büyütebilir, sayfayı otomatik kaydırarak elini gitardan çekmeden çalabilirsin.</p>
    <h3>Yeni başlayanlar için kolay şarkılar</h3>
    <p>Gitara yeni başladıysan <a href="/kolay-gitar-akorlari/">kolay gitar akorları</a> sayfasından yalnızca açık akorlarla çalınan şarkılara, <a href="/kapo-ile-kolay-sarkilar/">kapo ile kolay şarkılar</a> sayfasından da kapo takınca kolaylaşan şarkılara ulaşabilirsin. Bir akorun nasıl basıldığını <a href="/akorlar/">gitar akorları tablosunda</a> diyagramıyla görürsün.</p>
    <h3>Repertuarını oluştur</h3>
    <p>Sevdiğin şarkıları repertuarlarında topla, sahneye ya da arkadaş ortamına hazırlıklı git. Repertuarların iPhone'daki Gituar uygulamasıyla eşitlenir; kaydettiğin tonlar her yerde aynı kalır.</p>
  </section>
  <script src="../scripts/random.ts"></script>
  <script src="../scripts/recent.ts"></script>
  <script src="../scripts/home-reps.ts"></script>
  {picks.length === 0 && <script src="../scripts/editor-picks.ts"></script>}
</Base>
