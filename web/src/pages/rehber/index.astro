---
export const prerender = true;
import ListSection from "../../components/ListSection.astro";
import SeoText from "../../components/SeoText.astro";
import Base from "../../layouts/Base.astro";
import { siteUrl, breadcrumbJsonLd } from "../../lib/seo.ts";
const base = siteUrl(Astro.site);
const guides = [
  { path: "/rehber/akor-transpoze/", title: "Akor transpoze nasıl yapılır?", sub: "Yarım ses mantığı, örnekler, kapo ile transpoze" },
  { path: "/rehber/kapo/", title: "Kapo nedir, nasıl kullanılır?", sub: "Kapo tablosu, hangi perdeye takılır, Gituar'ın kapo hesabı" },
  { path: "/rehber/en-cok-kullanilan-akorlar/", title: "En çok kullanılan gitar akorları", sub: "Türkçe şarkıların akor analizi: en sık akorlar, tonlar" },
  { path: "/rehber/ukulele-akorlari/", title: "Ukulele akorları gitarla aynı mı?", sub: "Aynı akor adları, farklı tutuşlar; en kolay ukulele tonları" },
];
const description = "Gitar akorları rehberi: akor transpoze, kapo kullanımı, ukulele akorları ve Gituar'ın araçlarıyla şarkıları kendi tonunda çalma.";
---
<Base title="Gitar Akorları Rehberi – Transpoze, Kapo, Ukulele" description={description} jsonLd={[{ "@context": "https://schema.org", "@type": "CollectionPage", name: "Gitar akorları rehberi", url: `${base}/rehber/`, description, inLanguage: "tr" }, breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Rehber", path: "/rehber/" }])]}>
  <ListSection title="Gitar akorları rehberi" heading="h1" icon="book" color="#ff9500" open>
    <ul class="rp-list">
      {guides.map((g) => <li><a class="row" href={g.path} title={g.title}><span class="rp-badge rp-badge-guide" aria-hidden="true">R</span><span class="rp-text"><span class="row-title">{g.title}</span><span class="row-note"> · {g.sub}</span></span></a></li>)}
    </ul>
  </ListSection>
  <ListSection title="Gitar akorları tablosu" href="/akorlar/" />
  <SeoText title="Kısa, pratik gitar yazıları">
    <p>Tonu değiştirmek, kapo takmak, ukulele ile aynı akorları çalmak: şarkıları kendi sesine ve eline göre çalmanın yolları. Her yazının sonunda sık sorulan sorular var.</p>
  </SeoText>
</Base>
