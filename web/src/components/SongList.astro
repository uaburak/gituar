---
import type { CatalogSong } from "@shared/types";
import SongRow from "./SongRow.astro";
// Liste içinde reklam yok; reklamlar listelerin dışında (yan sütunlar, bölüm araları).
interface Props { songs: CatalogSong[]; showArtist?: boolean; numbered?: boolean; id?: string; notes?: Record<string, string> }
const { songs, showArtist = true, numbered = false, id, notes } = Astro.props;
---
<div class="list" id={id}>
  {songs.map((song, i) => <SongRow song={song} showArtist={showArtist} index={numbered ? i + 1 : undefined} note={notes?.[song.id]} />)}
</div>
