---
import Base from "../layouts/Base.astro";
import SongList from "../components/SongList.astro";
import ArtistRow from "../components/ArtistRow.astro";
import ListSection from "../components/ListSection.astro";
import { catalog, newestSongs, topArtists } from "../lib/catalog.ts";
import { siteUrl, homeJsonLd } from "../lib/seo.ts";

// Popüler: gerçek popülerlik puanı (kişi başına görüntülenme/favori/repertuar); puan yoksa en yeniler.
const all = catalog().songs;
const scored = [...all].filter((s) => (s.score ?? 0) > 0).sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
const popular = (scored.length >= 20 ? scored : [...scored, ...[...all].sort((a, b) => b.seq - a.seq).filter((s) => !scored.includes(s))]).slice(0, 20);
const newest = newestSongs(20);
const artists = topArtists(20);
const newestArtists = [...catalog().artists].sort((a, b) => Math.max(...b.songs.map((s) => s.seq)) - Math.max(...a.songs.map((s) => s.seq))).slice(0, 20);
const title = "Gitar Akorları – Türkçe Şarkı Akorları, Transpoze ve Kapo";
const description = "Türkçe şarkıların gitar akorları: topluluğun paylaştığı akorları transpoze, kapo ve otomatik kaydırma ile çal, repertuar oluştur. iPhone uygulamasıyla aynı akorlar.";
---
<Base title={title} description={description} jsonLd={homeJsonLd(siteUrl(Astro.site))}>
  <h1 class="visually-hidden">Türkçe gitar akorları</h1>
  <ListSection title="Popüler Akorlar" icon="bolt" color="#ff3b30" open>
    <SongList songs={popular} />
  </ListSection>
  <ListSection title="Rastgele" color="#af52de" action="btn-random" />
  <ListSection title="Öne Çıkanlar" color="#ffcc00" href="/editorun-secimleri/" note="Editörün seçimleri" />
  <ListSection title="Yeni Akorlar" color="#ff9500">
    <SongList songs={newest} />
    <a class="rp-more" href="/yeni-eklenenler/">Bütün yeni akorlar ›</a>
  </ListSection>
  <ListSection title="Gece Modu" icon="moon" color="var(--text)" action="theme-toggle-home" />
  <ListSection title="Son Çaldıklarım" icon="none" id="recent">
    <ul class="rp-list rp-split" id="recent-list"></ul>
    <p class="muted small" id="recent-empty">Açtığın şarkılar burada listelenir. Bu liste yalnızca bu tarayıcıda tutulur.</p>
  </ListSection>
  <ListSection title="Repertuarlarım" icon="none" href="/repertuarlarim/" />
  <ListSection title="Popüler Sanatçılar" icon="none">
    <div class="list rp-artists">{artists.map((a) => <ArtistRow artist={a} />)}</div>
  </ListSection>
  <ListSection title="Yeni Eklenen Sanatçılar" icon="none">
    <div class="list rp-artists">{newestArtists.map((a) => <ArtistRow artist={a} />)}</div>
  </ListSection>
  <ListSection title="Bütün Sanatçılar" icon="none" href="/sanatcilar/" note="A'dan Z'ye" />
  <ListSection title="Gitar Akor Tablosu" icon="none" href="/akorlar/" />
  <ListSection title="Kolay Gitar Akorları" icon="none" href="/kolay-gitar-akorlari/" />
  <ListSection title="Kapo ile Kolay Şarkılar" icon="none" href="/kapo-ile-kolay-sarkilar/" />
  <ListSection title="Tonlara Göre Şarkılar" icon="none" href="/ton/" />
  <ListSection title="Rehber" icon="none" href="/rehber/" note="Transpoze, kapo, ukulele" />
  <ListSection title="İstek, Öneri, Şikayet" icon="none" href="/iletisim/" />
  <ListSection title="gituar.com" icon="none" href="/hakkinda/" />
  <script src="../scripts/random.ts"></script>
  <script src="../scripts/recent.ts"></script>
</Base>
