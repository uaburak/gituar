---
// Alt bilgi (Wecra web-yeni · Web/Alt bilgi): marka + üç bağlantı sütunu, altta telif ve gece modu.
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { APP_STORE_URL, INSTAGRAM_URL } from "../lib/site.ts";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo"><Logo /><span>Gituar</span></div>
        <p>Türkçe şarkıların gitar akorları. Akorları topluluk ekler, editörler onaylar.</p>
        <a class="btn btn-appstore" href={APP_STORE_URL} rel="noopener"><Icon name="apple" class="icon-sm" />App Store'dan indir</a>
      </div>
      <div class="footer-cols">
        <nav aria-label="Keşfet">
          <span class="footer-title">Keşfet</span>
          <a href="/sanatcilar/">Sanatçılar</a>
          <a href="/akorlar/">Akorlar</a>
          <a href="/kolay-gitar-akorlari/">Kolay şarkılar</a>
          <a href="/kapo-ile-kolay-sarkilar/">Kapo ile kolay</a>
          <a href="/ton/">Tonlar</a>
          <a href="/yeni-eklenenler/">Yeni eklenenler</a>
        </nav>
        <nav aria-label="Gituar">
          <span class="footer-title">Gituar</span>
          <a href="/hakkinda/">Hakkında</a>
          <a href="/pro/">Gituar Pro</a>
          <a href={APP_STORE_URL} rel="noopener">iOS uygulaması</a>
          <a href={INSTAGRAM_URL} rel="me noopener">Instagram</a>
          <a href="/rehber/">Rehber</a>
          <a href="/iletisim/">İletişim</a>
        </nav>
        <nav aria-label="Yasal" class="footer-legal">
          <span class="footer-title">Yasal</span>
          <a href="/kullanim-sartlari/">Kullanım şartları</a>
          <a href="/gizlilik/">Gizlilik ve çerezler</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="copy">© {year} Gituar · Akorlar müzik eğitimi amacıyla yayımlanır, eserlerin hakları sahiplerine aittir.</span>
      <button type="button" class="footer-theme" id="theme-toggle-footer"><Icon name="moon" class="icon-sm" /><span>Gece modu</span></button>
    </div>
  </div>
</footer>
