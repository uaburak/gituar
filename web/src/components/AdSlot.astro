---
// Tek reklam bileşeni. Plus kullanıcılarında app.ts `html.plus` sınıfını koyar ve CSS hepsini gizler.
// AdSense yayıncı kimliği yoksa Wecra'daki gibi kesikli kutu kalır (tasarım ve ölçü kontrolü için).
import { ADSENSE_CLIENT, ADSENSE_SLOTS } from "../lib/site.ts";
interface Props { size: "side" | "leaderboard" | "rect" | "inline" | "sticky"; unit: string; class?: string }
const { size, unit, class: className = "" } = Astro.props;
const labels = { side: "160 × 600", leaderboard: "728 × 90", rect: "300 × 250", inline: "Liste içi · her 10 satırda bir", sticky: "320 × 50" };
const format = size === "side" ? "vertical" : size === "rect" ? "rectangle" : size === "sticky" ? "horizontal" : "auto";
// AdSense birimi (data-ad-slot) yer türüne göre .env'den gelir; `unit` yalnızca ölçüm/etiket içindir.
const slot = ADSENSE_SLOTS[size];
const live = Boolean(ADSENSE_CLIENT && slot);
// AdSense'te sabit boyutlu oluşturulan birimler (yan 160×600, mobil alt 320×50); diğerleri duyarlı
const fixed = size === "side" ? { w: 160, h: 600 } : size === "sticky" ? { w: 320, h: 50 } : null;
---
{(live || !ADSENSE_CLIENT) && (
  <div class:list={["ad-slot", `ad-${size}`, className]} data-unit={unit} aria-label="Reklam">
    {live
      ? (fixed
          ? <ins class="adsbygoogle" style={`display:inline-block;width:${fixed.w}px;height:${fixed.h}px`} data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}></ins>
          : <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format={format} data-full-width-responsive="true"></ins>)
      : <div class="ad-placeholder"><b>REKLAM</b><span>{labels[size]}</span></div>}
  </div>
)}
