---
import SeoText from "../../components/SeoText.astro";
import Base from "../../layouts/Base.astro";
import SongList from "../../components/SongList.astro";
import ListSection from "../../components/ListSection.astro";
import ArtistRow from "../../components/ArtistRow.astro";
import { catalog, topArtists, type ArtistGroup } from "../../lib/catalog.ts";
import { siteUrl, artistTitle, artistDescription, artistJsonLd } from "../../lib/seo.ts";
import { isThinArtist, featuredSongIds } from "../../lib/catalog-rules.mjs";
import { songChords, chordHref } from "../../lib/chord-stats.ts";

const foundArtist = catalog().artistBySlug.get(Astro.params.artist ?? "");
if (!foundArtist) return Astro.rewrite("/404/");
const artist: ArtistGroup = foundArtist;
const base = siteUrl(Astro.site);
const featured = featuredSongIds(artist.slug).map((id) => catalog().byId.get(id)).filter((s) => s !== undefined);
const thin = isThinArtist(artist.slug);
// Sanatçı özeti: en sık ton, en sık akorlar, en kolay şarkılar (en az 3 şarkılı sanatçılarda)
const n = artist.songs.length;
const keyCount = new Map<string, number>();
const chordCount = new Map<string, { n: number; root: string; quality: string }>();
for (const s of artist.songs) {
  if (s.originalKey) keyCount.set(s.originalKey, (keyCount.get(s.originalKey) ?? 0) + 1);
  for (const c of songChords(s).chords) {
    const e = chordCount.get(c.name) ?? { n: 0, root: c.root, quality: c.quality };
    e.n++;
    chordCount.set(c.name, e);
  }
}
const topKey = [...keyCount.entries()].sort((a, b) => b[1] - a[1])[0];
const topChords = [...chordCount.entries()].sort((a, b) => b[1].n - a[1].n).slice(0, 6);
const rank = { kolay: 0, orta: 1, ileri: 2 } as const;
const easiest = [...artist.songs]
  .filter((s) => songChords(s).chords.length >= 2)
  .sort((a, b) => rank[songChords(a).level] - rank[songChords(b).level] || songChords(a).chords.length - songChords(b).chords.length)
  .slice(0, 5);
const easyCount = artist.songs.filter((s) => songChords(s).level === "kolay").length;
const otherArtists = topArtists(20).filter((a) => a.slug !== artist.slug).slice(0, 19); // 20. hücre "Tümü"
const easyNotes = Object.fromEntries(easiest.map((s) => [s.id, songChords(s).chords.map((c) => c.name).join(" ")]));
---
<Base noindex={thin} title={artistTitle(artist)} description={artistDescription(artist)} ogType="profile" jsonLd={artistJsonLd(artist, base)}>
  <ListSection title={`${artist.name} akorları`} heading="h1" letter="S" color="#54779a" open>
    <SongList songs={artist.songs} cols={1} id="artist-songs" />
  </ListSection>
  {otherArtists.length > 0 && (
    <ListSection title="Benzer Sanatçılar" icon="none" open all="/sanatcilar/">
      <ul class="rp-list">{otherArtists.map((a) => <ArtistRow artist={a} />)}</ul>
    </ListSection>
  )}
  {n >= 5 && easiest.length >= 3 && (
    <ListSection title={`En kolay ${artist.name} şarkıları`} icon="none" all="/kolay-gitar-akorlari/">
      <SongList songs={easiest} cols={1} notes={easyNotes} />
    </ListSection>
  )}
  {featured.length > 0 && (
    <ListSection title={`${artist.name} düetleri`} icon="none">
      <SongList songs={featured} cols={1} />
    </ListSection>
  )}
  {n >= 3 && (
    <ListSection title="Bilgiler" icon="none">
      <ul class="rp-info rp-info-2">
        <li><span>Şarkı sayısı: </span><b>{n}</b></li>
        {topKey && <li><span>En sık ton: </span><b>{topKey[0]}</b></li>}
        {topChords.length > 0 && <li><span>En çok kullanılan akorlar: </span>{topChords.slice(0, 4).map(([name, c], i) => { const href = chordHref(c.root, c.quality); return <>{i > 0 && ", "}{href ? <a href={href}>{name}</a> : <b>{name}</b>}</>; })}</li>}
        {easyCount > 0 && <li><span>Barresiz çalınan: </span><b>{easyCount} şarkı</b></li>}
      </ul>
    </ListSection>
  )}
  <ListSection title="Bütün sanatçılar" icon="none" href="/sanatcilar/" />
  <ListSection title="Şarkı öner" icon="quote" color="#c077db" href="/iletisim/" />
  <SeoText title={`${artist.name} akorları ve şarkıları`}>
    <p>
      {artist.name} şarkılarının gitar akorları orijinal ton bilgisiyle bu sayfada.
      {n > 1 && <> {n} şarkının akorunu bulabilir, istediğini kendi sesine göre transpoze edip kapo ile çalabilirsin.</>}
      {topKey && n >= 3 && <> {artist.name} şarkılarında en sık kullanılan ton <b>{topKey[0]}</b>.</>}
    </p>
    {topChords.length > 0 && n >= 3 && (
      <p>
        Şarkılarda en çok geçen akorlar {topChords.slice(0, 5).map(([name, c], i) => { const href = chordHref(c.root, c.quality); return <>{i > 0 && ", "}{href ? <a href={href}>{name}</a> : name}</>; })}.
        Bu akorları öğrenirsen {artist.name} repertuarının büyük kısmını çalabilirsin; her akorun diyagramı ve basılışı akor sayfasında.
      </p>
    )}
    {easiest.length > 0 && n >= 3 && (
      <p>
        {easyCount > 0 ? <>{easyCount} şarkı barre gerektirmeden, yalnızca açık akorlarla çalınıyor. </> : ""}
        Başlamak için en kolay {artist.name} şarkıları: {easiest.slice(0, 3).map((x, i) => <>{i > 0 && ", "}<a href={`/akor/${x.artistSlug}/${x.slug}/`}>{x.songName}</a></>)}.
        Daha fazlası için <a href="/kolay-gitar-akorlari/">kolay gitar akorları</a> ve <a href="/kapo-ile-kolay-sarkilar/">kapo ile kolay şarkılar</a> sayfalarına bak.
      </p>
    )}
  </SeoText>
</Base>
