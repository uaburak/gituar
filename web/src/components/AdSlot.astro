---
// Tek reklam bileşeni. Pro kullanıcılarında app.ts `html.pro` sınıfını koyar ve CSS hepsini gizler.
// Yerleşim, büyük akor sitelerindeki düzene göre:
//   leaderboard → içerik kartının üstünde geniş üst şerit (masaüstü 970×90, tablet 728×90, telefon 320×100)
//   incontent   → akor kâğıdının hemen altında (geniş ekran 728×90, telefon 300×250)
//   Geniş yerlerin ölçüsü ekran genişliğine göre CSS'te sabittir (global.css): yer baştan ayrılır, reklam gelince sayfa kaymaz.
//   side        → içerik sütununun iki yanında, kaydırınca sabit kalan 160×600
//   sticky      → ekranın altında, kapatılabilen sabit şerit (masaüstü 970/728×90, mobil 320×50/100)
//   rect/inline → sayfa içi kutu ve liste aralarındaki reklamlar
//   video       → sayfa içinde sessiz başlayan video reklam (outstream); reklam bitince kutu kapanır.
//                 Canlıda AdSense'in kod birimi yok: AdSense'te "görüntülü reklam birimlerinde video" açılınca
//                 video reklamlar zaten diğer birimlerin içinde gelir. Bu yer yalnızca yerelde ve ileride
//                 Ad Manager / reklam ağı (VAST etiketi) bağlanınca çizilir.
import { ADSENSE_CLIENT, ADSENSE_SLOTS } from "../lib/site.ts";
type Size = "side" | "leaderboard" | "incontent" | "rect" | "inline" | "sticky" | "video";
interface Props { size: Size; unit: string; class?: string }
const { size, unit, class: className = "" } = Astro.props;
const labels: Record<Size, string> = { side: "160 × 600", leaderboard: "970 × 90 · 728 × 90 · 320 × 100", incontent: "728 × 90 · 300 × 250", rect: "300 × 250", inline: "728 × 90 · 320 × 100", sticky: "728 × 90 · 320 × 50", video: "Video · 16:9" };
const format = size === "side" ? "vertical" : size === "rect" ? "rectangle" : size === "sticky" ? "horizontal" : "auto";
// AdSense birimi (data-ad-slot) yer türüne göre .env'den gelir; `unit` yalnızca ölçüm/etiket içindir.
// Ayrı birim yoksa geniş yerler duyarlı liste içi birimi kullanır.
const slot = ADSENSE_SLOTS[size] || (size === "leaderboard" || size === "incontent" ? ADSENSE_SLOTS.inline : "");
// Yerelde (astro dev) AdSense reklam basmaz (onaylı alan adı ve birim ister). Bunun yerine Google'ın
// herkese açık örnek reklam ağından (Google Publisher Tag, /6355419/...) gerçek test reklamları çekilir.
// Canlıda hiçbir zaman çizilmez (import.meta.env.DEV yalnızca dev sunucusunda true). Üretim derlemesini yerelde
// test reklamlarıyla ölçmek için (Lighthouse) PUBLIC_AD_DEMO=1; Cloudflare derlemesinde bu değişken yok.
const demo = import.meta.env.DEV || import.meta.env.PUBLIC_AD_DEMO === "1";
const live = !demo && Boolean(ADSENSE_CLIENT && slot);
// Sabit ölçülü yerler: yan 160×600, kutu 300×250. Geniş yerlerin (üst, kâğıt altı, liste içi) ölçüsü ekran genişliğine
// göre CSS'ten gelir (global.css .ad-leaderboard/.ad-incontent/.ad-inline); AdSense o ölçüde reklam ister, sayfa kaymaz.
const fixed = size === "side" ? { w: 160, h: 600 } : size === "rect" ? { w: 300, h: 250 } : null;
const cssSized = size === "leaderboard" || size === "incontent" || size === "inline";
const close = size === "sticky";
---
{demo && size === "video" && (
  <div class:list={["ad-slot", "ad-video", "ad-test", className]} data-unit={unit} data-note="Google test video reklamı (yalnızca yerelde)">
    <div class="ad-video-box">
      <video class="ad-video-media" muted playsinline preload="none"></video>
      <div class="ad-video-ui"></div>
    </div>
  </div>
)}
{demo && size === "video" && (
  <script is:inline>
    // Google IMA SDK ile outstream video: Google'ın herkese açık örnek VAST etiketi (yalnızca yerelde).
    // Görünür olunca sessiz başlar; reklam bitince ya da reklam gelmezse kutu kapanır.
    (function () {
      const TAG = "https://pubads.g.doubleclick.net/gampad/ads?iu=/21775744923/external/single_ad_samples&sz=640x480&cust_params=sample_ct%3Dlinear&ciu_szs=300x250%2C728x90&gdfp_req=1&output=vast&unviewed_position_start=1&env=vp&impl=s&correlator=";
      const run = () => document.querySelectorAll(".ad-video:not([data-ima])").forEach((slot) => {
        slot.dataset.ima = "1";
        const video = slot.querySelector("video"), ui = slot.querySelector(".ad-video-ui");
        const collapse = () => slot.classList.add("ad-video-done");
        let manager;
        const start = () => {
          const ima = google.ima;
          const container = new ima.AdDisplayContainer(ui, video);
          container.initialize();
          const loader = new ima.AdsLoader(container);
          loader.addEventListener(ima.AdErrorEvent.Type.AD_ERROR, collapse);
          loader.addEventListener(ima.AdsManagerLoadedEvent.Type.ADS_MANAGER_LOADED, (e) => {
            manager = e.getAdsManager(video);
            manager.addEventListener(ima.AdErrorEvent.Type.AD_ERROR, collapse);
            manager.addEventListener(ima.AdEvent.Type.ALL_ADS_COMPLETED, collapse);
            manager.addEventListener(ima.AdEvent.Type.SKIPPED, collapse);
            manager.init(ui.offsetWidth, ui.offsetHeight, ima.ViewMode.NORMAL);
            manager.setVolume(0);
            manager.start();
          });
          const req = new ima.AdsRequest();
          req.adTagUrl = TAG + Date.now();
          req.linearAdSlotWidth = ui.offsetWidth; req.linearAdSlotHeight = ui.offsetHeight;
          req.nonLinearAdSlotWidth = ui.offsetWidth; req.nonLinearAdSlotHeight = ui.offsetHeight / 3;
          req.setAdWillAutoPlay(true); req.setAdWillPlayMuted(true);
          loader.requestAds(req);
        };
        new ResizeObserver(() => manager && manager.resize(ui.offsetWidth, ui.offsetHeight, google.ima.ViewMode.NORMAL)).observe(ui);
        const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { io.disconnect(); start(); } }, { threshold: 0.5 });
        io.observe(slot);
      });
      if (window.google && google.ima) return run();
      const s = document.createElement("script");
      s.src = "https://imasdk.googleapis.com/js/sdkloader/ima3.js";
      s.async = true;
      s.onload = run;
      s.onerror = () => document.querySelectorAll(".ad-video").forEach((x) => x.classList.add("ad-video-done"));
      document.head.appendChild(s);
    })();
  </script>
)}
{demo && size !== "video" && (
  <div class:list={["ad-slot", `ad-${size}`, "ad-test", className]} data-unit={unit} data-note="Google test reklamı (yalnızca yerelde)">
    {close && <button type="button" class="ad-close" aria-label="Reklamı kapat">×</button>}
    <div class="gpt-test" data-gpt-kind={size}></div>
    <span class="ad-test-label">Test reklamı · {labels[size]}</span>
  </div>
)}
{demo && size !== "video" && (
  <script is:inline>
    // Google Publisher Tag'i bir kez yükle; sayfadaki test yerlerini Google'ın herkese açık örnek ağından doldur.
    // Ölçüler canlıdaki sabit ölçülerle aynı (global.css): kutu önceden o boyutta, reklam gelince sayfa kaymaz.
    // Örnek ağ yalnızca 728×90, 300×250, 320×50 ve 160×600 verir; aynı boyutu sayfada çoğu zaman bir kez verir.
    // Boş dönen yer ölçülü test kutusu olarak kalır.
    if (!window.__gptTest) {
      window.__gptTest = true;
      window.googletag = window.googletag || { cmd: [] };
      const s = document.createElement("script");
      s.src = "https://securepubads.g.doubleclick.net/tag/js/gpt.js";
      s.async = true;
      document.head.appendChild(s);
      const mid = () => innerWidth >= 760;
      const kinds = {
        leaderboard: { unit: "/6355419/Travel/Asia", sizes: () => innerWidth >= 1024 ? [[970, 90], [728, 90]] : mid() ? [[728, 90]] : [[320, 100]] },
        incontent: { unit: "/6355419/Travel/Europe/France", sizes: () => mid() ? [[728, 90]] : [[300, 250]] },
        inline: { unit: "/6355419/Travel/Europe/Germany", sizes: () => mid() ? [[728, 90]] : [[320, 100]] },
        rect: { unit: "/6355419/Travel/Europe/Germany", sizes: () => [[300, 250]] },
        side: { unit: "/6355419/Travel/Europe", sizes: () => [[160, 600]] },
        sticky: { unit: "/6355419/Travel/Europe", sizes: () => mid() ? [[970, 90], [728, 90]] : [[320, 100], [320, 50]] },
      };
      const fill = () => googletag.cmd.push(() => {
        let n = 0;
        document.querySelectorAll(".gpt-test:not([id])").forEach((el) => {
          const box = el.closest(".ad-slot");
          if (getComputedStyle(box).display === "none" || (el.closest(".side-ad") && !el.closest(".side-ad").offsetWidth)) return;
          const k = kinds[el.dataset.gptKind];
          el.id = "gpt-test-" + (n++);
          googletag.defineSlot(k.unit, k.sizes(), el.id)?.addService(googletag.pubads());
        });
        // Sayfa geçişinde tam ekran reklam (interstitial): site içi bir bağlantıya tıklanınca açılır
        const inter = googletag.defineOutOfPageSlot("/6355419/Travel/Europe/France/Paris", googletag.enums.OutOfPageFormat.INTERSTITIAL);
        if (inter) inter.addService(googletag.pubads());
        googletag.pubads().addEventListener("slotRenderEnded", (e) => {
          const el = document.getElementById(e.slot.getSlotElementId());
          el?.closest(".ad-slot")?.classList.toggle("ad-test-empty", e.isEmpty);
        });
        googletag.pubads().enableSingleRequest();
        googletag.enableServices();
        document.querySelectorAll(".gpt-test[id]").forEach((el) => googletag.display(el.id));
        if (inter) googletag.display(inter);
      });
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", fill); else fill();
    }
  </script>
)}
{!demo && size !== "video" && (live || !ADSENSE_CLIENT) && (
  <div class:list={["ad-slot", `ad-${size}`, className]} data-unit={unit}>
    {close && <button type="button" class="ad-close" aria-label="Reklamı kapat">×</button>}
    {live
      ? (fixed
          ? <ins class="adsbygoogle" style={`display:inline-block;width:${fixed.w}px;height:${fixed.h}px`} data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}></ins>
          : cssSized
            ? <ins class="adsbygoogle" style="display:inline-block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}></ins>
            : <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot} data-ad-format={format} data-full-width-responsive="true"></ins>)
      : <div class="ad-placeholder"><b>REKLAM</b><span>{labels[size]}</span></div>}
  </div>
)}
{close && (
  <script is:inline>
    // Alt şeridin kapatma düğmesi: yalnızca bu sayfa için gizler
    document.querySelectorAll(".ad-sticky .ad-close").forEach((b) => b.addEventListener("click", () => b.closest(".ad-sticky").remove()));
  </script>
)}
