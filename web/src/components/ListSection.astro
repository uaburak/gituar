---
// Liste bölümü (Repertuarım düzeni): 74 px başlık satırı + renkli ikon. İçerik varsa açılır/kapanır (<details>),
// href verilirse başlık doğrudan bağlantıdır, action verilirse düğmedir. İçerik her zaman sayfada (SEO).
interface Props {
  title: string;
  /** İkon adı. Verilmezse (ya da "dot"/"none") başlıktan uygun ikon seçilir. */
  icon?: string;
  color?: string;
  open?: boolean;
  href?: string;
  action?: string;
  id?: string;
  heading?: "h1" | "h2";
  note?: string;
}
const { title, icon: iconProp, color: colorProp, open = false, href, action, id, heading = "h2", note } = Astro.props;

// Hat ikonları (24'lük kutu; s = çizgi, f = dolgu). Renk currentColor → bölümün rengi.
const S = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const ICONS: Record<string, string> = {
  bolt: '<path fill="currentColor" d="M13.5 2 4 14h7l-1.5 8L19 10h-7z"/>',
  shuffle: `<path ${S} d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>`,
  sparkles: '<path fill="currentColor" d="M11 2.5l2.1 5.6 5.6 2.1-5.6 2.1L11 17.9l-2.1-5.6-5.6-2.1 5.6-2.1zM19 14l.9 2.3 2.3.9-2.3.9L19 20.4l-.9-2.3-2.3-.9 2.3-.9z"/>',
  new: `<rect ${S} x="3.5" y="3.5" width="17" height="17" rx="4"/><path ${S} d="M12 8v8M8 12h8"/>`,
  moon: '<path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  history: `<path ${S} d="M4 12a8 8 0 1 0 2.4-5.7L4 8.7"/><path ${S} d="M4 4v4.7h4.7M12 8v4.5l3 2"/>`,
  bookmark: '<path fill="currentColor" d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1Z"/>',
  users: '<path fill="currentColor" d="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7 .5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 18.2c0-3 2.9-5.2 6.5-5.2s6.5 2.2 6.5 5.2c0 .6-.4 1-1 1h-11c-.6 0-1-.4-1-1Zm14.2 1c.2-.3.3-.7.3-1 0-1.9-.9-3.5-2.3-4.7.4-.1.9-.2 1.3-.2 3 0 5.5 1.9 5.5 4.3 0 .5-.4 1-1 1h-3.3a2 2 0 0 1-.5.6Z"/>',
  "user-plus": `<circle ${S} cx="9" cy="8" r="3.5"/><path ${S} d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M19 8v6M16 11h6"/>`,
  message: `<path ${S} d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1Z"/><path ${S} d="M8 10h8M8 13h5"/>`,
  heart: '<path fill="currentColor" d="M12 21s-7.4-4.5-9.4-9.1C1.2 8.6 3.4 5 6.9 5c2 0 3.5 1.1 5.1 3 1.6-1.9 3.1-3 5.1-3 3.5 0 5.7 3.6 4.3 6.9C19.4 16.5 12 21 12 21Z"/>',
  home: `<path ${S} d="M3 11 12 4l9 7M5.5 9.5V20h13V9.5M10 20v-5h4v5"/>`,
  flag: `<path ${S} d="M5 21V4m0 0h11l-2 4 2 4H5"/>`,
  info: `<circle ${S} cx="12" cy="12" r="9"/><path ${S} d="M12 11v6M12 7.5v.01"/>`,
  help: `<circle ${S} cx="12" cy="12" r="9"/><path ${S} d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.9-.9 1.5v.7M12 17.5v.01"/>`,
  book: `<path ${S} d="M12 6.5C10.5 5 8 4.5 4 4.5v14c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2v-14c-4 0-6.5.5-8 2Zm0 0v14"/>`,
  chord: `<rect ${S} x="5" y="3" width="14" height="18" rx="2"/><path ${S} d="M9.7 3v18M14.3 3v18M5 8.5h14M5 14h14"/><circle fill="currentColor" cx="9.7" cy="11.2" r="1.8"/><circle fill="currentColor" cx="14.3" cy="16.8" r="1.8"/>`,
  easy: `<circle ${S} cx="12" cy="12" r="9"/><path ${S} d="m8 12.2 2.8 2.8L16.2 9"/>`,
  capo: `<rect fill="currentColor" x="2.5" y="6" width="19" height="5" rx="2.5"/><path ${S} d="M6 11v10M10 11v10M14 11v10M18 11v10M6 3v3M10 3v3M14 3v3M18 3v3"/>`,
  key: `<path ${S} d="M8.5 3v7a3.5 3.5 0 0 0 7 0V3M12 13.5V21M9.5 21h5"/>`,
  search: `<circle ${S} cx="11" cy="11" r="7"/><path ${S} d="m20 20-3.5-3.5"/>`,
  music: `<path ${S} d="M9 18V5l11-2v13"/><circle ${S} cx="6" cy="18" r="3"/><circle ${S} cx="17" cy="16" r="3"/>`,
  hash: `<path ${S} d="M5 9h14M5 15h14M10 4 8 20M16 4l-2 16"/>`,
  file: `<path ${S} d="M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path ${S} d="M14 3v5h5M9.5 13h5M9.5 17h5"/>`,
  shield: `<path ${S} d="M12 3 4.5 6v6c0 4.6 3.2 7.8 7.5 9 4.3-1.2 7.5-4.4 7.5-9V6z"/><path ${S} d="m9 12 2 2 4-4"/>`,
  mail: `<rect ${S} x="3" y="5" width="18" height="14" rx="2"/><path ${S} d="m3.5 7 8.5 6 8.5-6"/>`,
  plus: `<circle ${S} cx="12" cy="12" r="9"/><path ${S} d="M12 8v8M8 12h8"/>`,
  duet: `<circle ${S} cx="8" cy="9" r="3"/><circle ${S} cx="16" cy="9" r="3"/><path ${S} d="M2.5 20c0-3 2.4-5 5.5-5 1.6 0 3 .5 4 1.4 1-.9 2.4-1.4 4-1.4 3.1 0 5.5 2 5.5 5"/>`,
  star: '<path fill="currentColor" d="m12 2.6 2.9 6.1 6.7.8-4.9 4.6 1.3 6.6L12 17.4l-6 3.3 1.3-6.6L2.4 9.5l6.7-.8z"/>',
  list: `<path ${S} d="M9 6h11M9 12h11M9 18h11"/><circle fill="currentColor" cx="4.5" cy="6" r="1.5"/><circle fill="currentColor" cx="4.5" cy="12" r="1.5"/><circle fill="currentColor" cx="4.5" cy="18" r="1.5"/>`,
};
const ALIAS: Record<string, string> = { quote: "message", dot: "", none: "" };

// Başlıktan ikon: ilk eşleşen kural kazanır (Türkçe küçük harfe çevrilerek).
const RULES: [RegExp, string][] = [
  [/popüler akor/, "bolt"], [/rastgele/, "shuffle"], [/öne çıkan|editör/, "sparkles"],
  [/yeni eklenen sanatçı/, "user-plus"], [/yeni repertuar/, "plus"], [/gece/, "moon"],
  [/son çaldık/, "history"], [/hata bildir/, "flag"], [/istek|şarkı öner/, "message"],
  [/repertuar/, "bookmark"], [/düet/, "duet"], [/sanatçı/, "users"], [/şarkı ara/, "search"],
  [/gituar\.com/, "heart"], [/ana sayfa/, "home"], [/bilgiler|hakkında/, "info"], [/sık sorulan/, "help"],
  [/rehber|yazılar/, "book"], [/kapo/, "capo"], [/ton(u|lar|undaki|unun)?\b|tonlar/, "key"],
  [/kolay|barresiz|açık akorlarla/, "easy"], [/akor sayısı/, "hash"],
  [/akor(ları)? tablosu|açık akorlar$|akoru$|akorları$|ilgili akor/, "chord"], [/yeni/, "new"],
  [/gizlilik|çerez/, "shield"], [/iletişim|telif/, "mail"], [/kullanım şart/, "file"],
  [/şarkı|akor/, "music"],
];
const lower = title.toLocaleLowerCase("tr-TR");
const named = iconProp ? (ALIAS[iconProp] ?? iconProp) : "";
const icon = (named && ICONS[named]) ? named : (RULES.find(([re]) => re.test(lower))?.[1] ?? "list");
const svg = ICONS[icon];

// Renk verilmezse başlığa göre sabit bir renk (Repertuarım paleti): aynı başlık her sayfada aynı renkte.
const PALETTE = ["#ea494d", "#c077db", "#f0a800", "#ff9500", "#54779a", "#499c9f"];
let h = 0;
for (const ch of title) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const color = colorProp ?? PALETTE[h % PALETTE.length];
const H = heading;
---
{href ? (
  <a class="rp-section rp-title" href={href} id={id}>
    <span class="rp-icon" style={`--c:${color}`} aria-hidden="true"><svg viewBox="0 0 24 24" set:html={svg} /></span>
    <H>{title}</H>{note && <span class="rp-note">{note}</span>}
  </a>
) : action ? (
  <button type="button" class="rp-section rp-title" id={action}>
    <span class="rp-icon" style={`--c:${color}`} aria-hidden="true"><svg viewBox="0 0 24 24" set:html={svg} /></span>
    <H>{title}</H>{note && <span class="rp-note">{note}</span>}
  </button>
) : (
  <details class="rp-section" open={open} id={id}>
    <summary class="rp-title">
      <span class="rp-icon" style={`--c:${color}`} aria-hidden="true"><svg viewBox="0 0 24 24" set:html={svg} /></span>
      <H>{title}</H>{note && <span class="rp-note">{note}</span>}
      <span class="rp-chev" aria-hidden="true"></span>
    </summary>
    <div class="rp-body"><slot /></div>
  </details>
)}
