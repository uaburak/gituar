---
import ListSection from "../../components/ListSection.astro";
import SeoText from "../../components/SeoText.astro";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { catalog, artistPath, type ArtistGroup } from "../../lib/catalog.ts";
import { siteUrl, artistsIndexJsonLd } from "../../lib/seo.ts";
import { turkeyNormalized } from "@shared/turkish";

const groups = new Map<string, ArtistGroup[]>();
for (const a of catalog().artists) {
  const first = turkeyNormalized(a.name)[0] ?? "#";
  const letter = /[a-z]/.test(first) ? first.toUpperCase() : "#";
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter)!.push(a);
}
const letters = [...groups.keys()].sort((x, y) => (x === "#" ? 1 : y === "#" ? -1 : x.localeCompare(y)));
const artistTotal = catalog().artists.length;
const count = artistTotal.toLocaleString("tr-TR");
const anchor = (l: string) => `h-${l === "#" ? "diger" : l}`;
---
<Base
  title="Sanatçılar – Gitar Akorları A'dan Z'ye"
  description={`Sanatçıların gitar akorları alfabetik dizinde. Sanatçıyı seç, şarkı akorlarını orijinal tonuyla gör; transpoze ve kapo ile çal.`}
  jsonLd={artistsIndexJsonLd(siteUrl(Astro.site), artistTotal)}
>
  <ListSection title="Sanatçılar" heading="h1" icon="users" color="#499c9f" fixed />
  <div class="rp-filter-row">
    <form class="search-inline rp-filter" role="search" onsubmit="return false">
      <Icon name="search" />
      <input type="search" id="artist-filter" placeholder="Sanatçı ara" autocomplete="off" aria-label="Sanatçı ara" />
      <kbd class="key" aria-hidden="true">/</kbd>
    </form>
  </div>
  <nav class="letters rp-letters" aria-label="Harfler">{letters.map((l) => <a href={`#${anchor(l)}`} data-letter={anchor(l)}>{l === "#" ? "0-9" : l}</a>)}</nav>
  {letters.map((l) => (
    <section class="rp-section rp-static" id={anchor(l)} data-group>
      <div class="rp-title"><span class="rp-icon rp-icon-letter" style="--c:#54779a" aria-hidden="true">{l === "#" ? "#" : l}</span><h2>{l === "#" ? "0-9" : l}</h2><span class="rp-note">{groups.get(l)!.length} sanatçı</span></div>
      <ul class="rp-list rp-split">
        {groups.get(l)!.map((a) => (
          <li><a class="row rp-artist-row" href={artistPath(a.slug)} title={`${a.name} akorları`}><span class="rp-badge rp-badge-artist" aria-hidden="true">S</span><span class="rp-text"><span class="row-title">{a.name}</span><span class="row-note"> · {a.songs.length} akor</span></span></a></li>
        ))}
      </ul>
    </section>
  ))}
  <p class="muted small rp-empty" id="filter-empty" hidden>Bu aramayla eşleşen sanatçı yok.</p>
  <SeoText title="Sanatçıların gitar akorları">
    <p>Türkçe pop, rock, arabesk, türkü ve yabancı şarkıların gitar akorları sanatçıya göre alfabetik dizinde. Sanatçıyı seçince bütün şarkılarının akorlarını orijinal tonlarıyla görürsün; istediğin şarkıyı kendi sesine göre <a href="/rehber/akor-transpoze/">transpoze</a> edebilir, kapo ile kolaylaştırabilir, otomatik kaydırma ile elin gitardayken çalabilirsin.</p>
    <h3>Sanatçı nasıl bulunur?</h3>
    <p>Yukarıdaki harf şeridinden sanatçının baş harfine atla ya da üstteki arama kutusuna adını yaz. Her sanatçı sayfasında şarkı listesi, en sık kullanılan ton, en çok geçen akorlar ve barre gerektirmeyen en kolay şarkılar yer alır.</p>
    <h3>Akorları kim ekliyor?</h3>
    <p>Gituar'daki akorları topluluk ekler, editörler kontrol eder. Aradığın sanatçı ya da şarkı yoksa <a href="/iletisim/">bize yaz</a>; Gituar uygulamasından kendi şarkını da ekleyebilirsin.</p>
  </SeoText>
  <script src="../../scripts/artist-filter.ts"></script>
</Base>
