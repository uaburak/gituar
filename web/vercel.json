{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/search-index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/plus/",
      "destination": "/pro/",
      "permanent": true
    },
    {
      "source": "/akor/",
      "destination": "/akorlar/",
      "permanent": true
    },
    {
      "source": "/akor/:artist/",
      "destination": "/sanatci/:artist/",
      "permanent": true
    },
    {
      "source": "/sanatci/",
      "destination": "/sanatcilar/",
      "permanent": true
    },
    {
      "source": "/ton/d-bemol/",
      "destination": "/ton/c-diyez/",
      "permanent": true
    },
    {
      "source": "/ton/d-diyez/",
      "destination": "/ton/e-bemol/",
      "permanent": true
    },
    {
      "source": "/ton/a-bemol/",
      "destination": "/ton/g-diyez/",
      "permanent": true
    },
    {
      "source": "/ton/a-diyez-minor/",
      "destination": "/ton/b-bemol-minor/",
      "permanent": true
    },
    {
      "source": "/ton/a-bemol-minor/",
      "destination": "/ton/g-diyez-minor/",
      "permanent": true
    },
    {
      "source": "/ton/e-bemol-minor/",
      "destination": "/ton/d-diyez-minor/",
      "permanent": true
    },
    {
      "source": "/ton/g-bemol/",
      "destination": "/ton/f-diyez/",
      "permanent": true
    },
    {
      "source": "/ton/d-bemol-minor/",
      "destination": "/ton/c-diyez-minor/",
      "permanent": true
    },
    {
      "source": "/ton/a-diyez/",
      "destination": "/ton/b-bemol/",
      "permanent": true
    }
  ],
  "ignoreCommand": "exit 0"
}
