---
import SeoText from "../../components/SeoText.astro";
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
import { catalog } from "../../lib/catalog.ts";
import { keySlug, keyTurkish } from "../../lib/keys.ts";
import { allKeyInfos, minKeySongs } from "../../lib/catalog-rules.mjs";
import { siteUrl, breadcrumbJsonLd } from "../../lib/seo.ts";

void catalog;
const keys = allKeyInfos().filter((k) => k.total >= minKeySongs()).sort((a, b) => b.total - a.total).map((k) => [k.spellings.join(" / "), k.total, k.name] as const);
const base = siteUrl(Astro.site);
const description = "Gitar akorlarını tona göre bul: majör ve minör tonlarda şarkı listeleri, her tonun sık kullanılan akorları. Transpoze ve kapo ile istediğin tona taşı.";
---
<Base title="Tona Göre Şarkı Akorları – Majör ve Minör Tonlar" description={description} jsonLd={[{ "@context": "https://schema.org", "@type": "CollectionPage", name: "Tona göre şarkı akorları", url: `${base}/ton/`, description, inLanguage: "tr" }, breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Tonlar", path: "/ton/" }])]}>
  <ListSection title="Tona göre şarkı akorları" heading="h1" icon="key" color="#54779a" open>
    <ul class="rp-list">
      {keys.map(([label, n, k]) => (
        <li><a class="row" href={`/ton/${keySlug(k)}/`} title={`${label} tonunda şarkı akorları`}><span class="rp-badge rp-badge-key" aria-hidden="true">{k}</span><span class="rp-text"><span class="row-title">{label} tonu</span><span class="row-note"> · {keyTurkish(k)}</span></span></a></li>
      ))}
    </ul>
  </ListSection>
  <ListSection title="Gitar akorları tablosu" href="/akorlar/" />
  <SeoText title="Hangi tonda çalmak istiyorsun?">
    <p>Bir şarkının tonu, şarkının etrafında döndüğü ana akordur. Hangi tonda çalmak istiyorsan o tondaki şarkıları listele: ton sayfasında o tonun en sık kullanılan akorları ve o tonda yazılmış şarkılar yer alır.</p>
    <h3>Majör ve minör tonlar</h3>
    <p>Majör tonlar (C, G, D) daha aydınlık, minör tonlar (Am, Em, Dm) daha hüzünlü bir hava verir. Türkçe şarkılarda minör tonlar oldukça yaygındır. Aynı tondaki şarkılar çoğunlukla aynı akorları kullandığı için, bir tonun akorlarını öğrendiğinde o tondaki pek çok şarkıyı çalabilirsin.</p>
    <h3>Ton sesime uymuyorsa?</h3>
    <p>Şarkı sayfasındaki ton seçiciyle akorları tek dokunuşla yukarı ya da aşağı taşıyabilir, kapo ekleyebilirsin. Nasıl yapıldığını <a href="/rehber/akor-transpoze/">akor transpoze rehberinde</a> anlatıyoruz.</p>
  </SeoText>
</Base>
