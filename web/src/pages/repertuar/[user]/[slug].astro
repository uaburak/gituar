---
// Herkese açık repertuar: /repertuar/{kullanıcı adı}/{repertuar slug'ı}/ — sunucuda şarkılarıyla üretilir.
import SeoText from "../../../components/SeoText.astro";
import Base from "../../../layouts/Base.astro";
import SongList from "../../../components/SongList.astro";
import { catalog } from "../../../lib/catalog.ts";
import { findPublicRepertoire } from "../../../lib/public-repertoire.ts";
import { siteUrl, breadcrumbJsonLd } from "../../../lib/seo.ts";
import { songPath } from "@shared/catalog";

const user = decodeURIComponent(Astro.params.user ?? "").toLocaleLowerCase("tr-TR");
const slug = decodeURIComponent(Astro.params.slug ?? "").toLowerCase();
const rep = user && slug ? await findPublicRepertoire(user, slug) : null;
if (!rep) return Astro.rewrite("/404/");
const byId = catalog().byId;
const songs = rep.songIds.map((id) => byId.get(id)).filter((s) => s !== undefined);
const base = siteUrl(Astro.site);
const path = `/repertuar/${encodeURIComponent(rep.ownerUsername)}/${encodeURIComponent(rep.slug)}/`;
const title = `${rep.name} – @${rep.ownerUsername} repertuarı`;
const description = `@${rep.ownerUsername} kullanıcısının "${rep.name}" repertuarı: ${songs.slice(0, 5).map((s) => `${s.artist} – ${s.songName}`).join(", ")}${songs.length > 5 ? " ve diğerleri" : ""}. Gitar akorlarıyla.`;
const jsonLd = [
  { "@type": "ItemList", name: rep.name, url: base + path, itemListElement: songs.slice(0, 50).map((s, i) => ({ "@type": "ListItem", position: i + 1, name: `${s.artist} – ${s.songName}`, url: base + songPath(s) })) },
  breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Editörün seçimleri", path: "/editorun-secimleri/" }, { name: rep.name }]),
];
// Tanıtım metni: repertuardaki sanatçılar ve en sık tonlar
const artistNames = [...new Set(songs.map((s) => s.artist))];
const keyCount = new Map<string, number>();
for (const s of songs) if (s.originalKey) keyCount.set(s.originalKey, (keyCount.get(s.originalKey) ?? 0) + 1);
const topKeys = [...keyCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([k]) => k);
const listText = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(", ")} ve ${xs[xs.length - 1]}` : xs[0] ?? "");
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=600");
---
<Base title={title} description={description} canonicalPath={path} noindex={songs.length < 3} jsonLd={jsonLd}>
  <div class="rp-section rp-static rp-rep-head" id="rep" data-id={rep.id} data-name={rep.name} data-owner={rep.ownerId} data-songs={rep.songIds.join(",")}>
    <div class="rp-title">
      <span class="rp-icon" style="--c:#0a84ff" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg></span>
      <h1>{rep.name}</h1>
      <span class="rp-owner">@{rep.ownerUsername}</span>
      <button type="button" class="rp-save" id="rep-save">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1Z"/></svg>
        <span>Repertuara kaydet</span>
      </button>
    </div>
  </div>
  <SongList songs={songs} />
  {songs.length === 0 && <p class="muted small rp-empty">Bu repertuarda henüz şarkı yok.</p>}
  <script src="../../../scripts/repertoire-save.ts"></script>
  {songs.length > 0 && (
    <SeoText title={`${rep.name} gitar akorları`}>
      <p>"{rep.name}", @{rep.ownerUsername} tarafından hazırlanan bir Gituar repertuarı; içinde {songs.length} şarkının gitar akorları var. {artistNames.length > 5 ? `Listedeki sanatçılardan bazıları: ${listText(artistNames.slice(0, 5))}.` : `Listedeki ${artistNames.length > 1 ? "sanatçılar" : "sanatçı"}: ${listText(artistNames)}.`}</p>
      {topKeys.length > 0 && <p>Repertuarda en sık geçen tonlar {listText(topKeys)}. Şarkıya tıklayınca akorları orijinal tonuyla açılır; tonu kendi sesine göre değiştirebilir, kapo ekleyebilir ve sayfayı otomatik kaydırarak çalabilirsin.</p>}
      <p>Sen de çaldığın şarkıları kendi repertuarında toplayabilirsin: şarkı sayfasındaki "Repertuara Ekle" ile listeni oluştur, iPhone'daki Gituar uygulamasıyla her yerde aynı listeye ulaş.</p>
    </SeoText>
  )}
</Base>
