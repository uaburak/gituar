---
// Yasal sayfalar için ortak kabuk: başlık, güncelleme tarihi, gövde ve diğer yasal sayfalara bağlantılar.
import Base from "../layouts/Base.astro";
interface Props { title: string; description: string; updated: string; path: string }
const { title, description, updated, path } = Astro.props;
const links = [
  { path: "/hakkinda/", label: "Hakkında ve SSS" },
  { path: "/kullanim-sartlari/", label: "Kullanım Şartları" },
  { path: "/gizlilik/", label: "Gizlilik ve Çerez Politikası" },
  { path: "/iletisim/", label: "İletişim ve telif" },
];
---
<Base title={title} description={description} ads={false}>
  <div class="crumbs"><a href="/">Ana sayfa</a><span>/</span>{title}</div>
  <div class="legal-layout">
    <nav class="card legal-menu" aria-label="Yasal sayfalar">
      {links.map((l) => <a href={l.path} aria-current={l.path === path ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <article class="guide-body legal-body">
      <h1>{title}</h1>
      <p class="legal-updated">Son güncelleme: {updated}</p>
      <slot />
    </article>
  </div>
</Base>
