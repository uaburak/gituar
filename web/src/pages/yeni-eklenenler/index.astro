---
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
import SongList from "../../components/SongList.astro";
import { newestSongs } from "../../lib/catalog.ts";
import { siteUrl, breadcrumbJsonLd } from "../../lib/seo.ts";
import { songPath } from "@shared/catalog";

const songs = newestSongs(200);
const base = siteUrl(Astro.site);
const description = "Gituar'a en son eklenen 200 şarkının gitar akorları. Yeni çıkan ve yeni eklenen Türkçe şarkı akorları her yayında güncellenir.";
const jsonLd = [
  { "@type": "CollectionPage", name: "Yeni eklenen akorlar", url: `${base}/yeni-eklenenler/`, description, inLanguage: "tr" },
  { "@type": "ItemList", name: "Yeni eklenen akorlar", numberOfItems: songs.length, itemListElement: songs.slice(0, 20).map((s, i) => ({ "@type": "ListItem", position: i + 1, name: `${s.artist} – ${s.songName}`, url: base + songPath(s) })) },
  breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Yeni eklenenler" }]),
];
---
<Base title="Yeni Eklenen Gitar Akorları – Son 200 Şarkı" description={description} jsonLd={jsonLd}>
  <ListSection title="Yeni eklenen akorlar" heading="h1" icon="none" open>
    <SongList songs={songs} />
  </ListSection>
  <ListSection title="Popüler sanatçılar" color="#ffcc00" href="/sanatcilar/" />
</Base>
