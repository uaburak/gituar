---
import Base from "../../layouts/Base.astro";
import SongList from "../../components/SongList.astro";
import SeoText from "../../components/SeoText.astro";
import ListSection from "../../components/ListSection.astro";
import { catalog } from "../../lib/catalog.ts";
import { keySlug, keyTurkish, diatonicChords } from "../../lib/keys.ts";
import { keyInfo, allKeyInfos, minKeySongs } from "../../lib/catalog-rules.mjs";
import { siteUrl, breadcrumbJsonLd, fitTitle } from "../../lib/seo.ts";
import type { CatalogSong } from "@shared/types";

// Adresteki ton (ör. "a-minor") → eşsesli grubun asıl adı ve şarkıları
const info = allKeyInfos().find((k) => keySlug(k.name) === Astro.params.key);
if (!info || info.total < minKeySongs()) return Astro.rewrite("/404/");
const key = info.name;
const aliases = info.spellings.filter((k) => k !== key);
const songs: CatalogSong[] = catalog().songs.filter((s) => keyInfo((s.originalKey ?? "").trim())?.name === key);
const label = [key, ...aliases].join(" / ");
const total = songs.length;
const LIMIT = 300;
const list = [...songs].sort((a, b) => b.seq - a.seq).slice(0, LIMIT);
const chords = diatonicChords(key);
const tr = keyTurkish(key);
const title = fitTitle([`${label} Tonunda Şarkı Akorları – ${tr}`, `${label} Tonunda Şarkı Akorları`, `${key} Tonunda Şarkı Akorları`]);
const description = `${label} (${tr}) tonundaki şarkıların gitar akorları. Bu tonda sık kullanılan akorlar: ${chords.join(", ")}. Transpoze ve kapo ile istediğin tona taşı.`;
const base = siteUrl(Astro.site);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "CollectionPage", name: `${key} tonunda şarkı akorları`, url: `${base}/ton/${keySlug(key)}/`, description, inLanguage: "tr" },
  breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Tonlar", path: "/ton/" }, { name: `${key} tonu`, path: `/ton/${keySlug(key)}/` }]),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <ListSection title={`${label} tonunda şarkı akorları`} heading="h1" icon="key" color="#54779a" open note={tr}>
    <SongList songs={list} />
    {total > LIMIT && <p class="muted small rp-empty">En yeni {LIMIT} şarkı gösteriliyor; diğerleri için <a href={`/ara/?q=${encodeURIComponent(key)}`}>arama</a> ya da <a href="/sanatcilar/">sanatçı dizini</a>.</p>}
  </ListSection>
  <ListSection title={`${key} tonunun akorları`}>
    <div class="rp-pills">{chords.map((c) => <span class="mono">{c}</span>)}</div>
  </ListSection>
  <ListSection title="Bütün tonlar" href="/ton/" />
  <SeoText title={`${key} tonu`}>
    <p>{key} tonunda sık kullanılan akorlar: <strong>{chords.join(", ")}</strong>. Bu tondaki şarkıların çoğu bu akorların bir kısmıyla çalınır; akorları öğrendiğinde listedeki şarkılara rahatça eşlik edebilirsin.</p>
    <p>Ton sesine yüksek ya da alçak geliyorsa şarkı sayfasındaki ton seçiciyle akorları <a href="/rehber/akor-transpoze/">transpoze</a> edebilir, barre akorlar zor geliyorsa <a href="/rehber/kapo/">kapo</a> takabilirsin. Diğer tonlar için <a href="/ton/">tona göre şarkı akorları</a> sayfasına bak.</p>
  </SeoText>
</Base>
