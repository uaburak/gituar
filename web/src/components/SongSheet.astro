---
import { selectableKeys, rootNote } from "@shared/chords";
import type { CatalogSong } from "@shared/types";
import { sheetHtml } from "../lib/sheet-html.ts";
import Icon from "./Icon.astro";
interface Props { song: CatalogSong }
const { song } = Astro.props;
const originalRoot = rootNote(song.originalKey);
// Tonun kök dışındaki kısmı (C#m → "m"); seçicide her kök bu ekle gösterilir.
const keySuffix = (song.originalKey ?? "").trim().slice(originalRoot.length);
---
<article id="song" class="song-layout" data-id={song.id} data-key={song.originalKey} data-root={originalRoot} data-title={`${song.artist} - ${song.songName}`} data-name={song.songName} data-artist={song.artist}>
  <div class="tools" role="toolbar" aria-label="Akor araçları">
    <div class="ctl" aria-label="Ton">
      <button type="button" class="ctl-btn" id="key-dec" aria-label="Tonu yarım ses indir"><Icon name="minus" class="icon-sm" /></button>
      <label class="key-pick">
        <select id="key-select" aria-label="Ton seç">
          {selectableKeys.map((k) => <option value={k} selected={k === originalRoot}>{k + keySuffix}</option>)}
        </select>
        <span class="key-pick-label" id="key-label" aria-hidden="true">{originalRoot + keySuffix}</span>
        <Icon name="down" class="icon-sm" />
      </label>
      <button type="button" class="ctl-btn" id="key-inc" aria-label="Tonu yarım ses yükselt"><Icon name="plus" class="icon-sm" /></button>
      <span class="ctl-note" id="key-note">Orijinal</span>
    </div>
    <span class="tool-sep" aria-hidden="true"></span>
    <div class="ctl" aria-label="Kapo">
      <span class="ctl-label">Kapo</span>
      <button type="button" class="ctl-btn" id="capo-dec" aria-label="Kapo azalt"><Icon name="minus" class="icon-sm" /></button>
      <span class="ctl-val" id="capo-val">0</span>
      <button type="button" class="ctl-btn" id="capo-inc" aria-label="Kapo artır"><Icon name="plus" class="icon-sm" /></button>
    </div>
    <span class="tool-sep" aria-hidden="true"></span>
    <div class="ctl" aria-label="Yazı boyutu">
      <span class="ctl-label">Yazı</span>
      <button type="button" class="ctl-btn" id="font-dec" aria-label="Yazıyı küçült"><Icon name="minus" class="icon-sm" /></button>
      <span class="ctl-val" id="font-val">15</span>
      <button type="button" class="ctl-btn" id="font-inc" aria-label="Yazıyı büyüt"><Icon name="plus" class="icon-sm" /></button>
    </div>
    <span class="tool-sep" aria-hidden="true"></span>
    <button class="btn tb" id="btn-chords" type="button" aria-pressed="true">Akorları gizle</button>
    <button class="btn btn-text tb" id="btn-saved" type="button" hidden title="Kaydettiğin tona dön">Kayıtlı ton <b id="saved-key"></b></button>
    <button class="btn btn-primary tb" id="btn-save" type="button" hidden>Tonu kaydet</button>
    <button class="ctl-btn btn-reset" id="btn-reset" type="button" hidden aria-label="Orijinal tona ve kapoya dön" title="Orijinale dön"><Icon name="reset" class="icon-sm" /></button>
  </div>
  <div class="song-actions">
    <button class="btn btn-primary" id="btn-play" type="button" aria-pressed="false"><Icon name="play" class="icon-sm" /> Sayfayı oynat</button>
    <button class="btn btn-outline" id="btn-rep" type="button"><Icon name="bookmark" class="icon-sm" /> Repertuara ekle</button>
    <button class="btn btn-outline btn-round" id="btn-print" type="button" aria-label="Yazdır" title="Yazdır"><Icon name="print" class="icon-sm" /></button>
  </div>
  <div class="song-main">
    <div class="sheet" id="sheet">
      <pre class="chords" id="chords" set:html={sheetHtml(song.content)} />
    </div>
    <div class="ugc-note">
      <div class="ugc-head">
        <span class="ugc-by">Ekleyen @anonim</span>
        <button type="button" class="ugc-report" id="report-open"><Icon name="flag" class="icon-sm" />Şikayet et</button>
      </div>
      <p>Gituar, kullanıcıların kendi içeriklerini paylaştığı bir topluluk platformudur; tüm içerikler kullanıcı sorumluluğundadır. Bu içerik müzik eğitimi amacıyla yayımlanmış olup hakları sahiplerine aittir. Telif ihlali içerdiğini düşünüyorsan bizimle <a href="/iletisim/">iletişime</a> geç.</p>
    </div>
    <slot name="after" />
  </div>
  <aside class="song-rail" aria-label="Şarkı bilgileri"><slot name="rail" /></aside>
  <div class="play-bar" id="play-bar" aria-label="Otomatik kaydırma">
    <button class="btn tb" id="play-toggle" type="button">Durdur</button>
    <input type="range" id="play-speed" min="1" max="10" step="1" value="4" aria-label="Kaydırma hızı" />
    <button class="btn btn-text tb" id="play-close" type="button">Kapat</button>
  </div>

  <dialog id="report-dialog" class="card report-dialog">
    <div id="report-ask">
      <p class="report-title">İçeriği Şikayet Et</p>
      <p class="muted small">Bu içeriği neden şikayet etmek istiyorsunuz? İnceleme ekibimiz en kısa sürede kontrol edecektir.</p>
      <div class="report-actions">
        <button type="button" class="btn btn-block report-reason" data-reason="Uygunsuz İçerik">Uygunsuz İçerik</button>
        <button type="button" class="btn btn-block report-reason" data-reason="Telif Hakkı İhlali">Telif Hakkı İhlali</button>
        <button type="button" class="btn btn-block report-reason" data-reason="Yanlış Akor/Söz">Yanlış Akor/Söz</button>
        <button type="button" class="btn btn-text btn-block" id="report-cancel">Vazgeç</button>
      </div>
    </div>
    <div id="report-done" hidden>
      <p class="report-title" id="report-done-title"></p>
      <p class="muted small" id="report-done-text"></p>
      <div class="report-actions"><button type="button" class="btn btn-primary btn-block" id="report-ok">Tamam</button></div>
    </div>
  </dialog>

  <dialog id="rep-dialog" class="card">
    <p class="report-title" style="margin-bottom:12px">Repertuara ekle</p>
    <div id="rep-list" class="list" style="margin-bottom:16px"></div>
    <form id="rep-new" style="display:flex;gap:8px">
      <input class="input" name="name" placeholder="Yeni repertuar adı" style="flex:1" required />
      <button class="btn btn-primary" type="submit">Oluştur</button>
    </form>
    <button class="btn btn-text btn-block" id="rep-close" type="button" style="margin-top:8px">Kapat</button>
  </dialog>
</article>
<script src="../scripts/song-sheet.ts"></script>
