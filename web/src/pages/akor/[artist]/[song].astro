---
import { keySlug } from "../../../lib/keys.ts";
import { canonicalSongPath, keyInfo, minKeySongs } from "../../../lib/catalog-rules.mjs";
import Base from "../../../layouts/Base.astro";
import SongSheet from "../../../components/SongSheet.astro";
import SongList from "../../../components/SongList.astro";
import ListSection from "../../../components/ListSection.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ChordDiagram from "../../../components/ChordDiagram.astro";
import SeoText from "../../../components/SeoText.astro";
import { songChords, chordHref, LEVEL_LABEL } from "../../../lib/chord-stats.ts";
import { chordShapes } from "../../../lib/chord-theory.ts";
import { catalog, sameKeySongs, artistPath, songPath, songBySlug, newestSongs, songWithContent, type ApiSong } from "../../../lib/catalog.ts";
import { siteUrl, songTitleParts, songDescription, songJsonLd, usedChords } from "../../../lib/seo.ts";

// İstek anında: adres veritabanında yoksa 404
const found = songBySlug(Astro.params.artist ?? "", Astro.params.song ?? "");
if (!found) return Astro.rewrite("/404/");
// Dizinde metin yok; yalnızca bu şarkının metni istenir (sürüm adresli, önbellekten)
const song: ApiSong = await songWithContent(found);
const artist = catalog().artistBySlug.get(song.artistSlug);
const others = (artist?.songs ?? []).filter((s) => s.id !== song.id);
const similar = sameKeySongs(song, 10);
// Önerilen: önce aynı tondakiler, sonra sanatçının diğer şarkıları (en fazla 20)
// "Tümü" olan listeler 19 öğe gösterir; 20. hücre "Tümü" satırıdır.
const suggested = [...similar, ...others.filter((s) => !similar.includes(s))].slice(0, 19);
const newest = newestSongs(20).filter((s) => s.id !== song.id).slice(0, 19);
const chords = usedChords(song.content);
const base = siteUrl(Astro.site);
const { title, bare } = songTitleParts(song);
const canonicalPath = canonicalSongPath(`/akor/${song.artistSlug}/${song.slug}/`);
const keyPage = keyInfo(song.originalKey ?? "");
const keyHref = keyPage && keyPage.total >= minKeySongs() ? `/ton/${keySlug(keyPage.name)}/` : "";
const description = songDescription(song, chords);
const artistUrl = base + artistPath(song.artistSlug);
const analysis = songChords(song);
// Sayfanın altındaki özgün tanıtım metni: yalnızca bu şarkının verisinden (ton, akorlar, zorluk, kapo, ritim)
const chordLinks = analysis.chords.slice(0, 10).map((c) => ({ name: c.name, href: chordHref(c.root, c.quality) }));
const levelText = analysis.chords.length === 0 ? "" : analysis.level === "kolay"
  ? "Barre gerektirmeyen, yalnızca açık akorlarla çalınan kolay bir şarkı; gitara yeni başlayanlar için uygun."
  : analysis.level === "orta"
    ? `Orta zorlukta bir şarkı; ${analysis.barreCount} akorda barre gerekiyor.`
    : `İleri seviye bir şarkı; ${analysis.barreCount} akorda barre gerekiyor.`;
const rhythmText = [
  song.rhythm ? `ritim deseni ${song.rhythm}` : "",
  song.meter ? `ölçü ${song.meter}` : "",
  song.tempo ? `tempo yaklaşık ${song.tempo} BPM` : "",
].filter(Boolean).join(", ");
const moreBySame = others.slice(0, 3);
const diagrams = analysis.chords.slice(0, 12).map((c) => ({ ...c, shape: chordShapes(c.root, c.quality)[0], href: chordHref(c.root, c.quality) })).filter((c) => c.shape);
---
<Base title={title} bareTitle={bare} canonicalPath={canonicalPath} description={description} songId={song.id} ogType="music.song" jsonLd={songJsonLd(song, base)}>
  <Fragment slot="head">
    <meta property="music:musician" content={artistUrl} />
  </Fragment>
  <div class="rp-head rp-head-song">
    <h1>{song.songName} Akor - <a href={artistPath(song.artistSlug)}>{song.artist}</a></h1>
  </div>
  <SongSheet song={song}>
    <Fragment slot="diagrams">
      {diagrams.length > 0 ? (
        <div class="chord-grid">{diagrams.map((d) => <ChordDiagram shape={d.shape} label={d.name} href={d.href} />)}</div>
      ) : <p class="muted small">Bu şarkıdaki akorların diyagramı yok.</p>}
      <p class="muted small rp-diagram-note">Diyagramlar orijinal tondaki akorları gösterir. Kâğıttaki bir akorun üstüne gelince de diyagramı açılır. <a href="/akorlar/">Bütün akorlar</a></p>
    </Fragment>
    <Fragment slot="after">
      <ListSection title="Rastgele" color="#c077db" id="random">
        <ul class="rp-list" id="random-list" data-total={catalog().songs.length}></ul>
        <p class="muted small rp-empty" id="random-status">Yükleniyor…</p>
        <ul class="rp-list rp-all-holder"><li class="rp-all-item"><button type="button" class="row rp-all" id="random-refresh"><span class="rp-badge rp-badge-all" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.7-5.7L20 8.5M20 4v4.5h-4.5M20 12a8 8 0 0 1-13.7 5.7L4 15.5M4 20v-4.5h4.5"/></svg></span><span class="rp-text"><span class="row-title">Başka şarkılar getir</span></span></button></li></ul>
      </ListSection>
      <ListSection title={`${song.artist} akorları`} icon="music" color="#f0a800" href={artistPath(song.artistSlug)} />
      {suggested.length > 0 && (
        <ListSection title="Önerilen akorlar" icon="none" open all={artistPath(song.artistSlug)}>
          <SongList songs={suggested} />
        </ListSection>
      )}
      <AdSlot size="video" unit="song-video" />
      {keyHref && <ListSection title={`${song.originalKey} tonundaki şarkılar`} icon="none" href={keyHref} />}
      <ListSection title="Yeni Akorlar" color="#ff9500" all="/yeni-eklenenler/">
        <SongList songs={newest} />
      </ListSection>
      <ListSection title="Bilgiler" icon="none">
        <ul class="rp-info">
          <li><span>Sanatçı: </span><a href={artistPath(song.artistSlug)}>{song.artist}</a></li>
          {song.originalKey && <li><span>Orijinal ton: </span>{keyHref ? <a href={keyHref}>{song.originalKey}</a> : <b>{song.originalKey}</b>}</li>}
          {analysis.chords.length > 0 && <li><span>Zorluk: </span><b>{LEVEL_LABEL[analysis.level]}</b></li>}
          {chords.length > 0 && <li><span>Akorlar: </span><b>{chords.join(", ")}</b></li>}
          {analysis.capo && <li><span>Kapo ile kolay: </span><b>{analysis.capo.fret}. perde · {analysis.capo.shapes.join(", ")}</b></li>}
        </ul>
      </ListSection>
      <ListSection title="Bu içerik için hata bildir" color="#c077db" action="report-open-2" />
      <ListSection title="gituar.com" icon="heart" color="#ea494d" href="/" />
    </Fragment>
  </SongSheet>
  <script src="../../../scripts/random.ts"></script>
  <SeoText title={`${song.songName} akorları nasıl çalınır?`}>
    <p>
      <b>{song.songName}</b>, {song.artist} şarkısının gitar akorları{song.originalKey ? <> orijinal tonu <b>{song.originalKey}</b> ile</> : ""} bu sayfada.
      {chordLinks.length > 0 && <> Şarkıda {chordLinks.length} farklı akor var: {chordLinks.map((c, i) => <>{i > 0 && ", "}{c.href ? <a href={c.href}>{c.name}</a> : c.name}</>)}.</>}
      {levelText && <> {levelText}</>}
    </p>
    {analysis.capo ? (
      <p>Barre zor geliyorsa kapoyu <b>{analysis.capo.fret}. perdeye</b> takıp {analysis.capo.shapes.join(", ")} tutuşlarıyla çalabilirsin; şarkı yine aynı tonda duyulur. Kapo hesabı için <a href="/rehber/kapo/">kapo rehberine</a> bak.</p>
    ) : analysis.level !== "kolay" && analysis.chords.length > 0 ? (
      <p>Ton sesine yüksek ya da alçak geliyorsa sayfadaki ton seçiciyle akorları tek dokunuşla <a href="/rehber/akor-transpoze/">transpoze</a> edebilirsin.</p>
    ) : null}
    {rhythmText && <p>Çalarken {rhythmText}. "Çal" düğmesiyle şarkıyı bu ritimle dinleyip eşlik edebilirsin.</p>}
    <p>
      Otomatik kaydırma ile elin gitardayken sözler kendiliğinden akar; yazı boyutunu büyütebilir, akorları kendi repertuarına ekleyebilirsin.
      {moreBySame.length > 0 && <> {song.artist} şarkılarından {moreBySame.map((o, i) => <>{i > 0 && (i === moreBySame.length - 1 ? " ve " : ", ")}<a href={songPath(o)}>{o.songName}</a></>)} akorlarına da göz at ya da <a href={artistPath(song.artistSlug)}>bütün {song.artist} akorlarını</a> gör.</>}
      {keyHref && <> Aynı tondaki diğer şarkılar için <a href={keyHref}>{song.originalKey} tonundaki şarkılara</a> bakabilirsin.</>}
    </p>
  </SeoText>
</Base>
