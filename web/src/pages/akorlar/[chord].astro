---
// Akor sözlüğü: "{akor} akoru nasıl basılır" + o akorla çalınan şarkılar. En az 20 şarkıda geçen akorlar.
import Base from "../../layouts/Base.astro";
import SongList from "../../components/SongList.astro";
import ChordDiagram from "../../components/ChordDiagram.astro";
import SeoText from "../../components/SeoText.astro";
import ListSection from "../../components/ListSection.astro";
import { catalog } from "../../lib/catalog.ts";
import { chordPages, type ChordEntry } from "../../lib/chord-stats.ts";
import { chordShapes, chordNotes, chordTurkish, noteTurkish, QUALITIES, isOpenChord, chordSlug, SHARPS, pitchClass } from "../../lib/chord-theory.ts";
import { siteUrl, breadcrumbJsonLd, fitTitle } from "../../lib/seo.ts";
import { songPath } from "@shared/catalog";

const foundEntry = chordPages().find((c) => c.slug === Astro.params.chord);
if (!foundEntry) return Astro.rewrite("/404/");
const entry: ChordEntry = foundEntry;
const { root, quality, name } = entry;
const shapes = chordShapes(root, quality);
const notes = chordNotes(root, quality);
const tr = chordTurkish(root, quality);
const open = isOpenChord(root, quality);
const byId = catalog().byId;
const songs = entry.songIds.map((id) => byId.get(id)!).filter(Boolean).sort((a, b) => b.seq - a.seq);
const total = songs.length;
const LIMIT = 60;
const aliasText = entry.aliases.length ? ` (${entry.aliases.join(", ")})` : "";
const label = [name, ...entry.aliases].join(" / ");
const title = fitTitle([`${label} Akoru Nasıl Basılır? ${tr}, Diyagram`, `${label} Akoru Nasıl Basılır? ${tr}`, `${name} Akoru Nasıl Basılır?`]);
const first = shapes[0];
const howTo = open
  ? `${name} akoru açık tutuşla basılır, barre gerekmez.`
  : `${name} akoru barre ile basılır: işaret parmağın ${first?.barre ?? 1}. perdede telleri bastırır.`;
const description = `${name}${aliasText} akoru (${tr}) nasıl basılır: diyagram, notaları ${notes.join(" – ")}. ${howTo} ${name} akoruyla çalınan şarkılar.`.slice(0, 158);
// Aynı kökün diğer akorları ve aynı niteliğin komşu kökleri
const all = chordPages();
const sameRoot = all.filter((c) => c.root === root && c.slug !== entry.slug).slice(0, 8);
const pc = pitchClass(root);
const neighbors = all.filter((c) => c.quality === quality && c.slug !== entry.slug && Math.min((pitchClass(c.root) - pc + 12) % 12, (pc - pitchClass(c.root) + 12) % 12) <= 2).slice(0, 6);
const base = siteUrl(Astro.site);
const path = `/akorlar/${entry.slug}/`;
const answer = `${name} akoru, ${noteTurkish(root)} kökü üzerine kurulan ${QUALITIES[quality].tr} akordur. Notaları ${notes.join(", ")}. ${howTo}`;
const jsonLd = [
  { "@type": "WebPage", name: `${name} akoru nasıl basılır`, url: base + path, description, inLanguage: "tr", isPartOf: { "@id": `${base}/#website` }, about: { "@type": "Thing", name: `${name} akoru` } },
  { "@type": "ItemList", name: `${name} akoruyla çalınan şarkılar`, itemListElement: songs.slice(0, 20).map((s, i) => ({ "@type": "ListItem", position: i + 1, name: `${s.artist} – ${s.songName}`, url: base + songPath(s) })) },
  breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Akorlar", path: "/akorlar/" }, { name: `${name} akoru` }]),
];
void SHARPS; void chordSlug;
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <ListSection title={`${label} akoru nasıl basılır?`} heading="h1" icon="chord" color="#ea494d" open note={tr}>
    <div class="chord-shapes">
      {shapes.map((s, i) => <ChordDiagram shape={s} label={name} size={i === 0 ? "lg" : "sm"} caption={s.name} />)}
    </div>
    <ul class="rp-info">
      <li><span>Notalar: </span><b class="mono">{notes.join(" – ")}</b></li>
      <li><span>Tür: </span><b>{QUALITIES[quality].tr}</b></li>
      <li><span>Zorluk: </span><b>{open ? "Kolay · açık akor" : "Barre akor"}</b></li>
      {entry.aliases.length > 0 && <li><span>Diğer yazımı: </span><b class="mono">{entry.aliases.join(", ")}</b></li>}
    </ul>
  </ListSection>
  <ListSection title={`${name} akoruyla çalınan şarkılar`} open>
    <SongList songs={songs.slice(0, LIMIT)} />
  </ListSection>
  {(sameRoot.length > 0 || neighbors.length > 0) && (
    <ListSection title="İlgili akorlar" all="/akorlar/">
      <div class="rp-pills">{[...sameRoot, ...neighbors].map((c) => <a class="mono" href={`/akorlar/${c.slug}/`}>{c.name}</a>)}</div>
    </ListSection>
  )}
  <ListSection title="Gitar akorları tablosu" href="/akorlar/" />
  <SeoText title={`${name} akoru`}>
    <p>{answer}</p>
    {!open && <p>Barre zor geliyorsa kapo kullanabilirsin: <a href="/rehber/kapo/">kapo rehberi</a> ve <a href="/kapo-ile-kolay-sarkilar/">kapo ile kolay çalınan şarkılar</a>.</p>}
    {songs.length > 0 && <p>{name} akoruyla çalınan şarkılardan bazıları: {songs.slice(0, 5).map((x, i) => <>{i > 0 && ", "}<a href={songPath(x)}>{x.artist} - {x.songName}</a></>)}. Şarkı sayfasında akora dokununca diyagramı açılır ve sesini duyarsın.</p>}
    {sameRoot.length > 0 && <p>{noteTurkish(root)} köklü diğer akorlar: {sameRoot.slice(0, 6).map((c, i) => <>{i > 0 && ", "}<a href={`/akorlar/${c.slug}/`}>{c.name}</a></>)}. Bütün akorlar için <a href="/akorlar/">gitar akorları tablosuna</a> bak.</p>}
  </SeoText>
</Base>
