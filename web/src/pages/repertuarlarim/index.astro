---
import Base from "../../layouts/Base.astro";
---
<Base title="Repertuarlarım" noindex>
  <div class="page-head">
    <div class="title-row">
      <div><h1>Repertuarlarım</h1><p id="rep-meta">iPhone'daki Gituar ile eşitlenir</p></div>
      <button class="btn btn-primary" id="rep-new-btn" type="button" hidden>Yeni repertuar</button>
    </div>
  </div>
  <div id="rep-auth" class="alert" hidden>Repertuarlarını görmek için <a href="/giris/?next=/repertuarlarim/">giriş yap</a>.</div>
  <div class="grid-3" id="rep-grid">
    <form id="rep-create" class="card card-dashed rep-card" hidden>
      <h3 style="color:var(--accent-text)">Yeni repertuar</h3>
      <p class="muted small" style="margin:4px 0 12px">Bir isim ver, şarkıları şarkı sayfasından ekle.</p>
      <input class="input" name="name" placeholder="Repertuar adı" style="width:100%;margin-bottom:8px" required />
      <button class="btn btn-primary btn-block" type="submit">Oluştur</button>
    </form>
  </div>
  <p class="muted small" id="rep-status" style="margin-top:16px">Yükleniyor…</p>
  <script src="../../scripts/repertoires.ts"></script>
</Base>
