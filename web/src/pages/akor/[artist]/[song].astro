---
import { keySlug } from "../../../lib/keys.ts";
import { canonicalSongPath, keyInfo, minKeySongs } from "../../../lib/catalog-rules.mjs";
import Base from "../../../layouts/Base.astro";
import SongSheet from "../../../components/SongSheet.astro";
import SongList from "../../../components/SongList.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ChordDiagram from "../../../components/ChordDiagram.astro";
import { songChords, chordHref, LEVEL_LABEL } from "../../../lib/chord-stats.ts";
import { chordShapes } from "../../../lib/chord-theory.ts";
import { catalog, sameKeySongs, artistPath, songBySlug, type CatalogSong } from "../../../lib/catalog.ts";
import { siteUrl, songTitleParts, songDescription, songJsonLd, usedChords } from "../../../lib/seo.ts";

// İstek anında: adres veritabanında yoksa 404
const found = songBySlug(Astro.params.artist ?? "", Astro.params.song ?? "");
if (!found) return Astro.rewrite("/404/");
const song: CatalogSong = found;
const artist = catalog().artistBySlug.get(song.artistSlug);
const others = (artist?.songs ?? []).filter((s) => s.id !== song.id).slice(0, 8);
const similar = sameKeySongs(song, 5);
const diagramsShown = 8;
const chords = usedChords(song.content);
const base = siteUrl(Astro.site);
const { title, bare } = songTitleParts(song);
const canonicalPath = canonicalSongPath(`/akor/${song.artistSlug}/${song.slug}/`);
const keyPage = keyInfo(song.originalKey ?? "");
const keyHref = keyPage && keyPage.total >= minKeySongs() ? `/ton/${keySlug(keyPage.name)}/` : "";
const description = songDescription(song, chords);
const artistUrl = base + artistPath(song.artistSlug);
const analysis = songChords(song);
const diagrams = analysis.chords.slice(0, 12).map((c) => ({ ...c, shape: chordShapes(c.root, c.quality)[0], href: chordHref(c.root, c.quality) })).filter((c) => c.shape);
---
<Base title={title} bareTitle={bare} canonicalPath={canonicalPath} description={description} songId={song.id} ogType="music.song" jsonLd={songJsonLd(song, base)}>
  <Fragment slot="head">
    <meta property="music:musician" content={artistUrl} />
  </Fragment>
  <div class="page-head song-head">
    <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a><span>/</span><a href="/sanatcilar/">Sanatçılar</a><span>/</span><a href={artistPath(song.artistSlug)}>{song.artist}</a><span>/</span>{song.songName}</nav>
    <h1>{song.songName} <span class="h1-kw">akorları</span></h1>
    <div class="song-meta">
      <a href={artistPath(song.artistSlug)}>{song.artist}</a>
      {song.originalKey && <><span class="dot">·</span><span>Orijinal ton {song.originalKey}</span></>}
      {analysis.chords.length > 0 && <><span class="dot">·</span><span class={`row-level level-${analysis.level}`}>{LEVEL_LABEL[analysis.level]}</span></>}
    </div>
  </div>
  <SongSheet song={song}>
    <p class="song-intro" slot="after">
      {song.songName}, <a href={artistPath(song.artistSlug)}>{song.artist}</a> tarafından seslendirilen şarkının gitar akorları.
      {song.originalKey && chords.length > 0 && <>Orijinal ton {song.originalKey}; kullanılan akorlar: <span class="mono">{chords.join(", ")}</span>.</>}
      {song.originalKey && chords.length === 0 && <>Orijinal ton {song.originalKey}.</>}
      {!song.originalKey && chords.length > 0 && <>Kullanılan akorlar: <span class="mono">{chords.join(", ")}</span>.</>}
      {analysis.level === "kolay" && <>Barre gerektirmez, yalnızca açık akorlarla çalınır. </>}
      Tonu değiştirebilir, kapo ekleyebilir, otomatik kaydırma ile çalabilirsin.
    </p>
    <Fragment slot="rail">
      {diagrams.length > 0 && (
        <section class="card rail-card song-chords">
          <div class="rail-head"><h2>Bu şarkının akorları</h2><a href="/akorlar/">Akor tablosu</a></div>
          <div class="rail-diagrams">
            {diagrams.slice(0, diagramsShown).map((d) => <ChordDiagram shape={d.shape} label={d.name} href={d.href} />)}
          </div>
          <p class="rail-note">Diyagramlar orijinal tondaki akorları gösterir.</p>
        </section>
      )}
      {analysis.capo && (
        <section class="card rail-card">
          <span class="badge">İPUCU</span>
          <p class="rail-tip">Barre zor gelirse kapoyu {analysis.capo.fret}. perdeye tak</p>
          <p class="rail-tip-sub"><span class="mono">{analysis.capo.shapes.join(", ")}</span> tutarak aynı tonda çalarsın.</p>
        </section>
      )}
      <AdSlot size="rect" unit="song-rail" />
    </Fragment>
  </SongSheet>
  {(similar.length > 0 || others.length > 0) && (
    <div class="two-col song-more section">
      {similar.length > 0 && (
        <section>
          <div class="section-head"><h2>{song.originalKey ? `${song.originalKey} tonunda benzer şarkılar` : "Benzer şarkılar"}</h2>{keyHref && <a href={keyHref}>Tümü ›</a>}</div>
          <SongList songs={similar} />
        </section>
      )}
      {others.length > 0 && (
        <section>
          <div class="section-head"><h2>{song.artist} akorları</h2><a href={artistPath(song.artistSlug)}>Tümü ›</a></div>
          <SongList songs={others.slice(0, 5)} showArtist={false} />
        </section>
      )}
    </div>
  )}
</Base>
