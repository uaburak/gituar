---
export const prerender = true;
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="Repertuarlarım" noindex>
  <div class="rp-head">
    <h1>Repertuarlarım</h1>
  </div>
  <div class="rp-content"><p id="rep-meta" class="muted">iPhone'daki Gituar ile eşitlenir</p></div>
  <div id="rep-auth" class="alert" hidden>Repertuarlarını görmek için <a href="/giris/?next=/repertuarlarim/">giriş yap</a>.</div>
  <ListSection title="Repertuarlarım" icon="bolt" color="#ea494d" open>
    <ul class="rp-list" id="rep-grid"></ul>
    <p class="muted small rp-empty" id="rep-status">Yükleniyor…</p>
  </ListSection>
  <ListSection title="Yeni repertuar" icon="dot" color="#c077db" open>
    <form id="rep-create" class="rep-create rp-form" hidden>
      <input class="input" name="name" placeholder="Yeni repertuar adı · şarkıları şarkı sayfasından eklersin" required aria-label="Yeni repertuar adı" />
      <button class="btn btn-primary" type="submit">Oluştur</button>
    </form>
    <button class="btn btn-primary" id="rep-new-btn" type="button" hidden>Yeni repertuar</button>
  </ListSection>
  <script src="../../scripts/repertoires.ts"></script>
</Base>
