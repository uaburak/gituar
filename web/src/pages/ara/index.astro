---
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import SongList from "../../components/SongList.astro";
import { catalog, topArtists, artistPath } from "../../lib/catalog.ts";

// Boş aramada: gerçek popülerlik (API puanı: kişi başına görüntülenme 1, favori 4, repertuar 5) — puan yoksa en yeniler.
const c = catalog();
const popularSongs = [...c.songs].sort((a, b) => (b.score ?? 0) - (a.score ?? 0) || b.seq - a.seq).slice(0, 20);
const artistScore = new Map<string, number>();
for (const s of c.songs) if (s.score) artistScore.set(s.artistSlug, (artistScore.get(s.artistSlug) ?? 0) + s.score);
const byPop = [...artistScore.entries()].sort((a, b) => b[1] - a[1]).map(([slug]) => c.artistBySlug.get(slug)).filter((a) => a !== undefined);
const popularArtists = (byPop.length >= 12 ? byPop : [...byPop, ...topArtists(24).filter((a) => !byPop.includes(a))]).slice(0, 12);
const songsTitle = popularSongs.length ? "Popüler şarkılar" : "";
---
<Base title="Ara" description="Şarkı ya da sanatçı ara." noindex>
  <ListSection title="Şarkı ara" heading="h1" icon="search" color="#0a84ff" fixed />
  <form class="search-big rp-search" role="search" action="/ara/" method="get">
    <Icon name="search" />
    <input type="search" name="q" id="q" placeholder="Şarkı ya da sanatçı" autocomplete="off" aria-label="Ara" autofocus />
    <button class="icon-btn" type="button" id="q-clear" aria-label="Temizle" hidden><Icon name="close" /></button>
  </form>
  <p class="muted small rp-search-status" id="search-status">Şarkı adı, sanatçı ya da ikisi birden: "sezen gülümse" gibi.</p>

  <div id="popular">
    <ListSection title="Popüler sanatçılar" color="#499c9f" open all="/sanatcilar/">
      <div class="rp-pills">{popularArtists.map((a) => <a href={artistPath(a.slug)} title={`${a.name} akorları`}>{a.name}</a>)}</div>
    </ListSection>
    {popularSongs.length > 0 && (
      <ListSection title="Popüler şarkılar" icon="bolt" color="#ea494d" open all="/populer-akorlar/">
        <SongList songs={popularSongs.slice(0, 19)} />
      </ListSection>
    )}
  </div>

  <section id="artist-results" hidden>
    <ListSection title="Sanatçılar" color="#499c9f" fixed />
    <ul class="rp-list rp-flush" id="artist-list"></ul>
  </section>
  <section id="song-results" hidden>
    <ListSection title="Şarkılar" icon="music" color="#ea494d" fixed />
    <ul class="rp-list rp-flush" id="results"></ul>
    <button class="btn chip rp-show-more" id="show-more" type="button" hidden></button>
  </section>
  <script src="../../scripts/search.ts"></script>
</Base>
