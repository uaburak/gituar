---
import SeoText from "../../components/SeoText.astro";
import ListSection from "../../components/ListSection.astro";
import Base from "../../layouts/Base.astro";
import ChordDiagram from "../../components/ChordDiagram.astro";
import { chordPages } from "../../lib/chord-stats.ts";
import { chordShapes, SHARPS, pitchClass, isOpenChord } from "../../lib/chord-theory.ts";
import { siteUrl, breadcrumbJsonLd } from "../../lib/seo.ts";

const pages = chordPages();
const groups = SHARPS.map((note, pc) => ({
  note,
  chords: pages.filter((c) => pitchClass(c.root) === pc).sort((a, b) => b.songIds.length - a.songIds.length),
})).filter((g) => g.chords.length);
const basics = pages.filter((c) => isOpenChord(c.root, c.quality)).slice(0, 12);
const base = siteUrl(Astro.site);
const description = `Gitar akorları sözlüğü: akorların diyagramı, nasıl basıldığı ve o akorla çalınan şarkılar. Am, G, C, Em, F, Bm ve daha fazlası.`;
const jsonLd = [
  { "@type": "CollectionPage", name: "Gitar akorları sözlüğü", url: `${base}/akorlar/`, description, inLanguage: "tr", isPartOf: { "@id": `${base}/#website` } },
  breadcrumbJsonLd(base, [{ name: "Ana sayfa", path: "/" }, { name: "Akorlar" }]),
];
---
<Base title="Gitar Akorları Tablosu – Akor Nasıl Basılır?" description={description} jsonLd={jsonLd}>
  <ListSection title="Gitar akorları tablosu" heading="h1" icon="chord" color="#ea494d" open all="/kolay-gitar-akorlari/">
    <div class="chord-grid">
      {basics.map((c) => <ChordDiagram shape={chordShapes(c.root, c.quality)[0]} label={c.name} href={`/akorlar/${c.slug}/`} />)}
    </div>
  </ListSection>
  {groups.map((g) => (
    <ListSection title={`${g.note} akorları`} icon="chord">
      <div class="chord-grid">
        {g.chords.map((c) => <ChordDiagram shape={chordShapes(c.root, c.quality)[0]} label={c.name} href={`/akorlar/${c.slug}/`} />)}
      </div>
    </ListSection>
  ))}
  <ListSection title="Kolay gitar akorları" href="/kolay-gitar-akorlari/" />
  <ListSection title="Kapo ile kolay şarkılar" href="/kapo-ile-kolay-sarkilar/" />
  <SeoText title="Gitarda en çok kullanılan akorlar">
    <p>Gitarda en çok kullanılan akorlar Am, G, C, Em, Dm ve F'dir; Türkçe şarkıların büyük kısmı bu altı akorla çalınabilir. Yukarıdaki tabloda her akorun diyagramı var: hangi tele, hangi perdeye, hangi parmakla basılacağı gösteriliyor. Akora tıklayınca nasıl basıldığını, notalarını ve o akorla çalınan şarkıları görürsün.</p>
    <h3>Majör, minör ve yedili akorlar</h3>
    <p>Majör akorlar (C, G, D) parlak ve neşeli, minör akorlar (Am, Em, Dm) daha hüzünlü bir ses verir. Yedili akorlar (E7, A7, B7) ise genellikle bir sonraki akora geçişi hazırlar ve bir kıtanın sonunda duyulur. Barre akorlar (F, Bm) tek parmakla bütün telleri bastırmayı gerektirir; başta zorlanırsan <a href="/rehber/kapo/">kapo</a> ile aynı şarkıyı açık akorlarla çalabilirsin.</p>
    <h3>Nereden başlamalı?</h3>
    <p>Yeni başlıyorsan önce açık akorları öğren, sonra <a href="/kolay-gitar-akorlari/">kolay şarkılarla</a> pratik yap. Hangi akorların en çok geçtiğini merak ediyorsan <a href="/rehber/en-cok-kullanilan-akorlar/">en çok kullanılan gitar akorları</a> yazısına bak.</p>
  </SeoText>
</Base>
