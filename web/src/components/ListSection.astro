---
// Liste bölümü (Repertuarım düzeni): 74 px başlık satırı + renkli ikon. İçerik varsa açılır/kapanır (<details>),
// href verilirse başlık doğrudan bağlantıdır, action verilirse düğmedir. İçerik her zaman sayfada (SEO).
interface Props {
  title: string;
  icon?: "bolt" | "dot" | "moon" | "star" | "quote" | "heart" | "none";
  color?: string;
  open?: boolean;
  href?: string;
  action?: string;
  id?: string;
  heading?: "h1" | "h2";
  note?: string;
}
const { title, icon: iconProp = "dot", color: colorProp, open = false, href, action, id, heading = "h2", note } = Astro.props;
// Her satırın ikonu olur: "none" verilse de nokta çizilir. Renk verilmezse başlığa göre sabit bir renk seçilir
// (Repertuarım paleti), böylece aynı başlık her sayfada aynı renkte görünür.
const PALETTE = ["#ea494d", "#c077db", "#ffcc00", "#ff9500", "#54779a", "#499c9f"];
let h = 0;
for (const ch of title) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const icon = iconProp === "none" ? "dot" : iconProp;
const color = colorProp ?? PALETTE[h % PALETTE.length];
const H = heading;
---
{href ? (
  <a class="rp-section rp-title" href={href} id={id}>
    <span class={`rp-icon rp-icon-${icon}`} style={`--c:${color}`} aria-hidden="true"></span>
    <H>{title}</H>{note && <span class="rp-note">{note}</span>}
  </a>
) : action ? (
  <button type="button" class="rp-section rp-title" id={action}>
    <span class={`rp-icon rp-icon-${icon}`} style={`--c:${color}`} aria-hidden="true"></span>
    <H>{title}</H>{note && <span class="rp-note">{note}</span>}
  </button>
) : (
  <details class="rp-section" open={open} id={id}>
    <summary class="rp-title">
      <span class={`rp-icon rp-icon-${icon}`} style={`--c:${color}`} aria-hidden="true"></span>
      <H>{title}</H>{note && <span class="rp-note">{note}</span>}
    </summary>
    <div class="rp-body"><slot /></div>
  </details>
)}
